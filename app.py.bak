def get_margin_balance():
    try:
        balances = client.futures_account_balance()
        for balance in balances:
            if balance["asset"] == "USDT":
                return float(balance["balance"])
        return 0
    except Exception:
        return 0

def get_balance():
    try:
        balances = client.futures_account_balance()
        for balance in balances:
            if balance["asset"] == "USDT":
                return float(balance["balance"])
        return 0
    except Exception:
        return 0


def build_order_plan(symbol, balance, price, leverage, ai_decision=None, settings=None):
    filters = symbol_filters.get(symbol)
    if not filters or price <= 0:
        return {
            "valid": False,
            "qty": 0,
            "reason": "Filter symbol tidak tersedia atau harga tidak valid.",
        }

    ai_decision = ai_decision or {}
    settings = settings or get_runtime_settings()
    leverage = max(int(leverage or 0), 1)
    min_qty = filters["minQty"]
    min_notional = filters["minNotional"]
    step = filters["stepSize"]
    min_price = float(filters.get("minPrice", 0) or 0)
    if min_price > 0 and price < min_price:
        return {
            "valid": False,
            "qty": 0,
            "reason": f"Harga {price:.8f} di bawah minPrice {min_price:.8f}.",
        }
    min_qty_for_notional = (min_notional / price) if min_notional > 0 else 0

    if TEST_MINIMUM_TRADING_MODE:
        min_required_qty = max(min_qty, min_qty_for_notional)
        final_qty = ceil_step_size(min_required_qty, step)
        final_notional = final_qty * price
        if final_qty <= 0 or final_qty < min_qty or final_notional < min_notional:
            return {
                "valid": False,
                "qty": 0,
                "reason": "Qty minimum setelah pembulatan tidak lolos batas minimum exchange.",
            }

        max_position_notional = max(balance, 0) * leverage * 0.95
        if max_position_notional > 0 and final_notional > max_position_notional:
            return {
                "valid": False,
                "qty": 0,
                "reason": (
                    f"Saldo tidak cukup untuk minimum exchange {symbol}: "
                    f"notional {final_notional:.4f} > kapasitas {max_position_notional:.4f}."
                ),
            }

        tp_percent = max(TEST_TP_PERCENT, 0.01)
        sl_percent = max(TEST_SL_PERCENT, 0.01)
        risk_amount = final_notional * (sl_percent / 100)
        risk_percent = (risk_amount / balance * 100) if balance > 0 else 0.0
        return {
            "valid": True,
            "qty": final_qty,
            "risk_percent": round(risk_percent, 4),
            "risk_amount": round(risk_amount, 4),
            "sl_percent": round(sl_percent, 4),
            "tp_percent": round(tp_percent, 4),
            "risk_reward_ratio": round(calculate_risk_reward_ratio(tp_percent, sl_percent), 4),
            "position_notional": round(final_notional, 4),
            "margin_required": round(final_notional / leverage, 4) if leverage > 0 else 0.0,
            "reason": "Mode uji: qty dipaksa ke nominal minimum exchange.",
        }

    fixed_trade_notional_margin = float(
        settings.get("fixed_trade_notional_usdt", DEFAULT_FIXED_TRADE_NOTIONAL_USDT)
        or DEFAULT_FIXED_TRADE_NOTIONAL_USDT
    )
    fixed_trade_notional_margin = max(round(fixed_trade_notional_margin, 4), 0.0)
    min_trade_notional_margin = float(settings.get("min_trade_notional_usdt", 5.0))
    fixed_trade_notional_margin = max(fixed_trade_notional_margin, min_trade_notional_margin)
    
    fixed_trade_notional_usdt = fixed_trade_notional_margin * leverage
    min_trade_notional_usdt = min_trade_notional_margin * leverage
    fixed_trade_notional_usdt = max(fixed_trade_notional_usdt, min_trade_notional_usdt)
    
    if fixed_trade_notional_margin <= 0:
        return {
            "valid": False,
            "qty": 0,
            "reason": "Fixed trade margin harus lebih besar dari 0.",
        }

    configured_risk_percent = float(
        settings.get("risk_per_trade_percent", DEFAULT_RISK_PER_TRADE_PERCENT)
        or DEFAULT_RISK_PER_TRADE_PERCENT
    )
    max_risk_percent = max(
        float(settings.get("max_risk_per_trade_percent", MAX_RISK_PER_TRADE_PERCENT) or MAX_RISK_PER_TRADE_PERCENT),
        0.25,
    )
    suggested_risk_percent = float(ai_decision.get("suggested_risk_percent", configured_risk_percent) or configured_risk_percent)
    applied_risk_percent = min(configured_risk_percent, suggested_risk_percent, max_risk_percent)
    confidence = float(ai_decision.get("confidence", 0) or 0)
    if confidence < 0.7:
        applied_risk_percent *= 0.8
    if confidence < 0.62:
        applied_risk_percent *= 0.75
    applied_risk_percent = max(round(applied_risk_percent, 4), 0.2)
    sl_percent = float(ai_decision.get("sl_percent", 0) or 0)
    tp_percent = float(ai_decision.get("tp_percent", 0) or 0)
    if sl_percent <= 0:
        return {
            "valid": False,
            "qty": 0,
            "reason": "Stop loss percent dari AI tidak valid.",
        }

    risk_reward_ratio = float(ai_decision.get("risk_reward_ratio", 0) or 0)
    if risk_reward_ratio <= 0:
        risk_reward_ratio = calculate_risk_reward_ratio(tp_percent, sl_percent)
    min_risk_reward_ratio = float(
        settings.get("min_risk_reward_ratio", DEFAULT_MIN_RISK_REWARD_RATIO) or DEFAULT_MIN_RISK_REWARD_RATIO
    )
    if risk_reward_ratio < min_risk_reward_ratio:
        return {
            "valid": False,
            "qty": 0,
            "reason": (
                f"Risk-reward {risk_reward_ratio:.2f} lebih rendah dari minimal "
                f"{min_risk_reward_ratio:.2f}."
            ),
        }

    risk_budget = max(balance, 0) * (applied_risk_percent / 100)
    risk_based_notional = risk_budget / (sl_percent / 100) if sl_percent > 0 else 0
    position_notional = fixed_trade_notional_usdt
    if position_notional <= 0:
        return {
            "valid": False,
            "qty": 0,
            "reason": "Risk budget tidak cukup untuk membuat posisi valid.",
        }

    max_position_notional = max(balance, 0) * leverage * 0.95
    if max_position_notional > 0:
        position_notional = min(position_notional, max_position_notional)

    raw_qty = position_notional / price if price else 0
    min_required_qty = max(min_qty, min_qty_for_notional)
    if raw_qty < min_required_qty:
        return {
            "valid": False,
            "qty": 0,
            "reason": (
                f"Ukuran posisi fixed {symbol} terlalu kecil untuk rule exchange "
                f"({raw_qty:.6f} < minimum exchange {min_required_qty:.6f})."
            ),
        }

    final_qty = round_step_size(raw_qty, step)
    final_notional = final_qty * price
    if final_qty <= 0 or final_qty < min_qty or final_notional < min_notional:
        return {
            "valid": False,
            "qty": 0,
            "reason": "Qty akhir setelah pembulatan tidak lolos batas minimum exchange.",
        }

    risk_amount = final_notional * (sl_percent / 100)
    effective_risk_percent = (risk_amount / balance * 100) if balance > 0 else 0.0

    return {
        "valid": True,
        "qty": final_qty,
        "risk_percent": round(effective_risk_percent, 4),
        "risk_amount": round(risk_amount, 4),
        "sl_percent": round(sl_percent, 4),
        "tp_percent": round(tp_percent, 4),
        "risk_reward_ratio": round(risk_reward_ratio, 4),
        "position_notional": round(final_notional, 4),
        "margin_required": round(final_notional / leverage, 4) if leverage > 0 else 0.0,
        "reason": "Position sizing fixed notional per transaksi baru.",
    }


def has_open_position(symbol):
    try:
        positions = call_binance("futures_position_information")
        for position in positions:
            if position["symbol"] == symbol and float(position["positionAmt"]) != 0:
                return True
        return False
    except Exception:
        return False


def get_open_position(symbol):
    try:
        positions = call_binance("futures_position_information", symbol=symbol)
        for position in positions:
            amt = float(position.get("positionAmt", 0))
            if amt != 0:
                return position
        return None
    except Exception as exc:
        print(f"Open position error {symbol}:", exc)
        return None


def resolve_entry_price_from_exchange(symbol, fallback_price=0.0):
    try:
        pos = get_open_position(symbol)
        if pos:
            entry = float(pos.get("entryPrice", 0) or 0)
            if entry > 0:
                return entry
    except Exception:
        pass
    try:
        mark = float(client.futures_mark_price(symbol=symbol).get("markPrice", 0) or 0)
        if mark > 0:
            return mark
    except Exception:
        pass
    return float(fallback_price or 0)


def cancel_open_orders(symbol):
    try:
        call_binance("futures_cancel_all_open_orders", symbol=symbol)
    except Exception as exc:
        print(f"Cancel order error {symbol}:", exc)


def update_trade_on_close(symbol, pnl, close_price, reason):
    trades = load_trades()
    for trade in reversed(trades):
        if trade.get("symbol") == symbol and trade.get("status") == "OPEN":
            trade["status"] = "CLOSED"
            trade["pnl"] = round(float(pnl), 2)
            trade["close_price"] = round(float(close_price), 4)
            trade["close_reason"] = reason
            trade["closed_time"] = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            trades.sort(key=get_trade_reference_datetime)
            save_trades(trades)
            return trade
    return None


def close_position(symbol, reason="MANUAL"):
    with trade_execution_lock:
        position = get_open_position(symbol)
        if not position:
            return False, "Posisi tidak ditemukan atau sudah tertutup."

        amt = float(position["positionAmt"])
        if amt == 0:
            return False, "Posisi tidak aktif."

        side = "SELL" if amt > 0 else "BUY"
        qty = abs(amt)
        pnl = float(position.get("unRealizedProfit", 0))
        close_price = float(position.get("markPrice") or position.get("entryPrice") or 0)

        try:
            cancel_open_orders(symbol)
            call_binance("futures_create_order", **build_close_order_params(position, qty, side))
            update_trade_on_close(symbol, pnl, close_price, reason)
            emit_stats()
            socketio.emit(
                "position_closed",
                {
                    "symbol": symbol,
                    "reason": reason,
                    "pnl": round(pnl, 2),
                    "closed_at": datetime.now().strftime("%H:%M:%S"),
                },
            )
            return True, f"Posisi {symbol} berhasil ditutup."
        except Exception as exc:
            print(f"Close position error {symbol}:", exc)
            return False, str(exc)


def close_all_positions(reason="MANUAL_CLOSE_ALL"):
    results = []
    positions = get_current_positions()
    if not positions:
        return {
            "closed_count": 0,
            "failed_count": 0,
            "results": [],
        }

    for position in positions:
        symbol = position.get("symbol")
        success, message = close_position(symbol, reason=reason)
        results.append(
            {
                "symbol": symbol,
                "success": success,
                "message": message,
            }
        )

    return {
        "closed_count": sum(1 for item in results if item["success"]),
        "failed_count": sum(1 for item in results if not item["success"]),
        "results": results,
    }


def get_tp_sl_prices(symbol, side, entry, atr_percent=None, risk_mode="normal", tp_percent=None, sl_percent=None, leverage=None):
    symbol_filter = symbol_filters.get(symbol)
    if not symbol_filter:
        raise ValueError(f"Filter symbol {symbol} tidak ditemukan.")

    tick = symbol_filter["tickSize"]
    manual_tp_sl_map = load_manual_tp_sl()
    manual_tp_sl = manual_tp_sl_map.get(symbol, {})

    tp = manual_tp_sl.get("tp")
    sl = manual_tp_sl.get("sl")

    if tp is None or sl is None:
        settings = get_runtime_settings()
        if leverage is None:
            leverage = int(settings.get("default_leverage", DEFAULT_LEVERAGE))
        leverage_val = max(float(leverage or 10.0), 1.0)

        if tp_percent is not None and sl_percent is not None:
            tp_percent = max(float(tp_percent), 0.01)
            sl_percent = max(float(sl_percent), 0.01)
        else:
            auto_close_roi = float(settings.get("auto_close_roi_percent", AUTO_CLOSE_ROI_PERCENT))
            hard_stop_roi = abs(float(settings.get("hard_stop_roi_percent", HARD_STOP_ROI_PERCENT) or HARD_STOP_ROI_PERCENT))
            tp_percent = max(auto_close_roi / leverage_val, 0.01)
            sl_percent = max(hard_stop_roi / leverage_val, 0.01)

        if side == "BUY":
            tp = entry * (1 + (tp_percent / 100))
            sl = entry * (1 - (sl_percent / 100))
        else:
            tp = entry * (1 - (tp_percent / 100))
            sl = entry * (1 + (sl_percent / 100))

    tp = round_tick_size(float(tp), tick)
    sl = round_tick_size(float(sl), tick)

    min_price = max(float(tick), 1e-8)
    if tp <= 0:
        tp = min_price
    if sl <= 0:
        sl = min_price

    if side == "BUY" and sl >= entry:
        sl = round_tick_size(max(entry - max(entry * 0.001, min_price), min_price), tick)
    elif side == "SELL" and sl <= entry:
        sl = round_tick_size(entry + max(entry * 0.001, min_price), tick)

    if side == "BUY" and tp <= entry:
        tp = round_tick_size(entry + max(entry * 0.001, min_price), tick)
    elif side == "SELL" and tp >= entry:
        tp = round_tick_size(max(entry - max(entry * 0.001, min_price), min_price), tick)

    return tp, sl


def set_tp_sl(symbol, side, entry, atr_percent=None, risk_mode="normal", tp_percent=None, sl_percent=None, leverage=None):
    try:
        tp, sl = get_tp_sl_prices(
            symbol,
            side,
            entry,
            atr_percent=atr_percent,
            risk_mode=risk_mode,
            tp_percent=tp_percent,
            sl_percent=sl_percent,
            leverage=leverage,
        )
        validation_error = validate_tp_sl(side, entry, tp, sl)
        if validation_error:
            print(f"TP/SL skipped {symbol}: {validation_error}")
            return
        exit_side = "SELL" if side == "BUY" else "BUY"

        cancel_open_orders(symbol)

        if not TEST_MINIMUM_TRADING_MODE:
            call_binance(
                "futures_create_order",
                symbol=symbol,
                side=exit_side,
                type="TAKE_PROFIT_MARKET",
                stopPrice=tp,
                closePosition=True,
            )

        call_binance(
            "futures_create_order",
            symbol=symbol,
            side=exit_side,
            type="STOP_MARKET",
            stopPrice=sl,
            closePosition=True,
        )

        tp_label = f"trailing trigger {TEST_TRAILING_TRIGGER_ROI_PERCENT:.2f}% ROI" if TEST_MINIMUM_TRADING_MODE else tp
        print(f"TP/SL {symbol} | TP: {tp_label} | SL: {sl}")
    except Exception as exc:
        print("TP/SL error:", exc)
        text = str(exc)
        if "code=-4006" in text or "Stop price less than zero" in text:
            print(f"TP/SL skipped {symbol}: stop price invalid di exchange, lanjut tanpa TP/SL order.")
            return
        raise


def validate_tp_sl(side, entry, tp, sl):
    if tp <= 0 or sl <= 0:
        return "TP dan SL harus lebih besar dari 0."

    if side == "BUY":
        if tp <= entry:
            return "Untuk posisi BUY, TP harus di atas entry."
        if sl >= entry:
            return "Untuk posisi BUY, SL harus di bawah entry."
    else:
        if tp >= entry:
            return "Untuk posisi SELL, TP harus di bawah entry."
        if sl <= entry:
            return "Untuk posisi SELL, SL harus di atas entry."

    return None


def execute_trade(symbol):
    with trade_execution_lock:
        if symbol not in symbol_filters:
            return

        now = time.time()
        refresh_market_regime()
        settings = get_runtime_settings()
        max_open_positions = int(settings.get("max_open_positions", MAX_OPEN_POSITIONS))
        current_open_positions = get_open_position_count(trackable_only=True)
        if current_open_positions >= max_open_positions:
            print(f"MAX POSITIONS LIMIT REACHED: {current_open_positions} >= {max_open_positions}")
            return

        profile = get_strategy_profile(settings)
        min_score = max(
            int(settings.get("min_score", getattr(config, "MIN_SCORE", 3) or 3)),
            int(profile.get("min_score", 0) or 0),
        )
        if TEST_MINIMUM_TRADING_MODE:
            min_score = 1

        if symbol in get_blocked_symbols():
            detail = auto_blacklist_details.get(symbol, {})
            reason = detail.get("blacklist_reason", "manual")
            print(f"BLACKLIST SKIP {symbol}: {reason}")
            return

        if symbol in last_trade_time and now - last_trade_time[symbol] < COOLDOWN:
            return

        if has_open_position(symbol):
            return

        try:
            setup = evaluate_strategy_setup(symbol)
        except Exception as exc:
            if _is_retryable_network_error(exc):
                set_symbol_error_cooldown(symbol, seconds=240 if config.TESTNET else 120)
            print(f"SIGNAL ERROR {symbol}: {exc}")
            return

        if not setup.get("allowed"):
            print(f"SETUP SKIP {symbol}: {setup.get('reason')}")
            return

        closes = setup["closes_1m"]
        score = int(setup["score"])
        rsi = float(setup["rsi"])
        side = str(setup["side"])
        print(
            f"{symbol} | Score: {score} | RSI: {rsi} | Side: {side} | "
            f"Trend {setup['trend_1h']}/{setup['trend_15m']}/{setup['trend_5m']}"
        )

        if score < min_score:
            return

        balance = get_balance()
        trades = sync_closed_trades()
        stats = calculate_stats()
        stats.update(calculate_recent_trade_stats(trades=trades))
        stats.update(calculate_symbol_trade_stats(symbol, trades=trades))
        stats["is_priority_symbol"] = symbol in get_scan_symbols()[:TOP_SYMBOL_LIMIT]
        performance_context = build_recent_trade_performance_context(trades=trades, lookback_count=24)
        overall_recent_bucket = performance_context.get("overall", {})
        adaptive_buy_scalping_pause = bool(
            performance_context.get("adaptive_pauses", {}).get("buy_scalping", {}).get("active")
        )

        if adaptive_buy_scalping_pause and side == "BUY":
            print("ADAPTIVE PAUSE SKIP {}: BUY scalping dipause karena performa recent lemah.".format(symbol))
            return

        side_counts = get_open_position_side_counts(trackable_only=True)
        max_same_side_positions = max(2, min(max_open_positions - 1, 3))
        if side_counts.get(side, 0) >= max_same_side_positions:
            print(f"EXPOSURE CAP SKIP {symbol}: sisi {side} sudah {side_counts.get(side, 0)} posisi aktif.")
            return

        if (
            side == "BUY"
            and int(overall_recent_bucket.get("count", 0) or 0) >= 4
            and int(overall_recent_bucket.get("consecutive_losses", 0) or 0) >= 2
            and int(current_open_positions or 0) >= 2
        ):
            print("RECOVERY MODE SKIP {}: loss beruntun recent, tahan BUY baru saat posisi aktif masih padat.".format(symbol))
            return

        trade_leverage = int(settings.get("default_leverage", DEFAULT_LEVERAGE))
        preferred_margin_mode = normalize_margin_mode(
            settings.get("preferred_margin_mode", DEFAULT_MARGIN_MODE)
        )
        guard_config = {
            "recent_closed_count": int(performance_context.get("overall", {}).get("count", 0) or 0),
            "recent_winrate": float(performance_context.get("overall", {}).get("winrate", 0.0) or 0.0),
            "recent_hard_stop_rate": float(performance_context.get("overall", {}).get("hard_stop_rate", 0.0) or 0.0),
            "recent_profit_leaks": int(get_history_monitor_state().get("recent_profit_leaks", 0) or 0),
            "candidate_side": side,
            "buy_scalping_pause_active": adaptive_buy_scalping_pause,
            "max_open_positions": int(settings.get("max_open_positions", MAX_OPEN_POSITIONS)),
            "max_daily_loss_usdt": float(settings.get("max_daily_loss_usdt", MAX_DAILY_LOSS_USDT)),
            "max_consecutive_losses": int(settings.get("max_consecutive_losses", MAX_CONSECUTIVE_LOSSES)),
            "max_trades_per_hour": int(settings.get("max_trades_per_hour", MAX_TRADES_PER_HOUR)),
            "max_losses_per_hour": int(settings.get("max_losses_per_hour", MAX_LOSSES_PER_HOUR)),
            "hourly_loss_limit_usdt": float(settings.get("hourly_loss_limit_usdt", HOURLY_LOSS_LIMIT_USDT)),
            "loss_cooldown_minutes": int(settings.get("loss_cooldown_minutes", LOSS_COOLDOWN_MINUTES)),
            "max_symbol_trades_per_day": int(settings.get("max_symbol_trades_per_day", MAX_SYMBOL_TRADES_PER_DAY)),
            "max_symbol_losses_per_day": int(settings.get("max_symbol_losses_per_day", MAX_SYMBOL_LOSSES_PER_DAY)),
            "max_symbol_consecutive_losses": int(settings.get("max_symbol_consecutive_losses", MAX_SYMBOL_CONSECUTIVE_LOSSES)),
            "symbol_loss_cooldown_minutes": int(settings.get("symbol_loss_cooldown_minutes", SYMBOL_LOSS_COOLDOWN_MINUTES)),
            "hard_stop_symbol_cooldown_minutes": int(settings.get("hard_stop_symbol_cooldown_minutes", HARD_STOP_SYMBOL_COOLDOWN_MINUTES)),
        }
        guard = evaluate_pre_trade(symbol, balance, current_open_positions, stats, guard_config)
        if RISK_GUARD_ENABLED:
            active_policy = str(guard.get("policy", "allow") or "allow")
            if guard.get("halt_bot") and active_policy != "halt":
                active_policy = "halt"
            set_risk_guard_state(
                {
                    "policy": active_policy,
                    "symbol": symbol,
                    "reason": guard.get("reason", "Risk guard mengevaluasi trade."),
                    "risk_multiplier": guard.get("risk_multiplier", 1.0),
                    "confidence_boost": guard.get("confidence_boost", 0.0),
                    "leverage_cap": guard.get("leverage_cap"),
                }
            )
        if RISK_GUARD_ENABLED and not guard["allowed"]:
            auto_pause_on_guard_halt = bool(settings.get("auto_pause_on_guard_halt", AUTO_PAUSE_ON_GUARD_HALT))
            if guard.get("halt_bot") and auto_pause_on_guard_halt:
                pause_and_flatten_by_guard(guard["reason"])
            decision = {
                "symbol": symbol,
                "checked_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                "provider": "risk-guard",
                "mode": "guard",
                "allow_trade": False,
                "action": "BLOCK",
                "confidence": 1.0,
                "guard_policy": guard.get("policy", "block"),
                "risk_mode": ("halted" if guard.get("halt_bot") and auto_pause_on_guard_halt else "blocked"),
                "reason": guard["reason"],
            }
            add_ai_decision(decision)
            socketio.emit("ai_decision", decision)
            socketio.emit("ai_status", get_ai_status_payload())
            return

        ai_decision = evaluate_ai_trade(
            symbol,
            score,
            rsi,
            closes,
            setup=setup,
            balance=balance,
            settings=settings,
            performance_context=performance_context,
        )
        guard_reason = guard.get("reason", "")
        guard_risk_multiplier = float(guard.get("risk_multiplier", 1.0) or 1.0)
        guard_leverage_cap = guard.get("leverage_cap")
        guard_confidence_boost = float(guard.get("confidence_boost", 0.0) or 0.0)
        if guard_reason and guard.get("policy") not in {"allow", "idle"}:
            ai_decision["suggested_risk_percent"] = round(max(float(ai_decision.get("suggested_risk_percent", 0.2) or 0.2) * guard_risk_multiplier, 0.2), 4)
            if guard_leverage_cap is not None:
                ai_decision["suggested_leverage"] = min(int(ai_decision.get("suggested_leverage", trade_leverage) or trade_leverage), int(guard_leverage_cap))
            ai_decision["reason"] = f"{ai_decision['reason']}; Guard throttle: {guard_reason}"
        add_ai_decision(ai_decision)
        socketio.emit("ai_decision", ai_decision)
        socketio.emit("ai_status", get_ai_status_payload())

        min_ai_confidence = max(AI_MIN_CONFIDENCE, float(profile["ai_min_confidence"])) + guard_confidence_boost
        ai_filter_enabled = AI_ENABLED and not AI_ADVISORY_ONLY
        if ai_filter_enabled and (not ai_decision["allow_trade"] or ai_decision["confidence"] < min_ai_confidence):
            print(f"AI BLOCKED {symbol}: {ai_decision['reason']}")
            return
        if ai_filter_enabled and ai_decision.get("action") == "HOLD":
            print(f"AI BLOCKED {symbol}: action HOLD | {ai_decision['reason']}")
            return
        if ai_filter_enabled and ai_decision.get("action") in {"BUY", "SELL"} and ai_decision["action"] != side:
            print(f"AI SIDE MISMATCH {symbol}: setup {side}, ai {ai_decision['action']}")
            return

        effective_leverage = max(1, min(trade_leverage, int(ai_decision.get("suggested_leverage", trade_leverage) or trade_leverage)))
        if guard_leverage_cap is not None:
            effective_leverage = min(effective_leverage, int(guard_leverage_cap))

        order_plan = build_order_plan(symbol, balance, float(closes[-1]), effective_leverage, ai_decision=ai_decision, settings=settings)
        if not order_plan.get("valid"):
            print(f"ORDER PLAN SKIP {symbol}: {order_plan.get('reason')}")
            return

        ensure_margin_mode(symbol, preferred_margin_mode)
        set_leverage(symbol, effective_leverage)
        qty = order_plan["qty"]
        entry = float(closes[-1])
        order = call_binance("futures_create_order", symbol=symbol, side=side, type="MARKET", quantity=qty)
        entry = resolve_entry_price_from_exchange(symbol, fallback_price=entry)
        if entry <= 0:
            try:
                close_position(symbol, reason="INVALID_ENTRY_PRICE")
            except Exception:
                pass
            return
        risk_mode = ai_decision.get("risk_mode", "normal")
        tp_price, sl_price = get_tp_sl_prices(symbol, side, entry, atr_percent=setup.get("atr_percent"), risk_mode=risk_mode, tp_percent=order_plan["tp_percent"], sl_percent=order_plan["sl_percent"])

        trade = {
            "symbol": symbol,
            "side": side,
            "price": entry,
            "qty": qty,
            "score": score,
            "rsi": rsi,
            "ai_confidence": ai_decision["confidence"] if AI_ENABLED else None,
            "ai_reason": ai_decision["reason"] if AI_ENABLED else "AI disabled",
            "ai_mode": ai_decision["mode"] if AI_ENABLED else "disabled",
            "risk_mode": risk_mode,
            "strategy_family": ai_decision.get("strategy_family", "SCALPING"),
            "strategy_reason": setup.get("reason"),
            "market_regime": profile.get("market_regime", "UNKNOWN"),
            "trend_1h": setup.get("trend_1h"),
            "trend_15m": setup.get("trend_15m"),
            "trend_5m": setup.get("trend_5m"),
            "atr_percent": round(float(setup.get("atr_percent", 0) or 0), 4),
            "risk_percent": order_plan["risk_percent"],
            "risk_amount": order_plan["risk_amount"],
            "risk_reward_ratio": order_plan["risk_reward_ratio"],
            "position_notional": order_plan["position_notional"],
            "margin_required": order_plan["margin_required"],
            "suggested_leverage": effective_leverage,
            "preferred_margin_mode": preferred_margin_mode,
            "tp_price": tp_price,
            "sl_price": sl_price,
            "tp_percent": order_plan["tp_percent"],
            "sl_percent": order_plan["sl_percent"],
            "partial_tp_done": False,
            "peak_roi": 0.0,
            "breakeven_armed": False,
            "trailing_armed": False,
            "status": "OPEN",
            "time": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            "pnl": 0,
        }

        add_trade(trade)
        set_tp_sl(symbol, side, entry, atr_percent=setup.get("atr_percent"), risk_mode=risk_mode, tp_percent=order_plan["tp_percent"], sl_percent=order_plan["sl_percent"], leverage=effective_leverage)
        socketio.emit("new_trade", trade)
        print(f"TRADE {symbol} @ {entry}")
        last_trade_time[symbol] = now

def build_ranked_trade_candidates(symbols):
    ranked = []
    settings = get_runtime_settings()
    profile = get_strategy_profile(settings)
    min_score = max(
        int(settings.get("min_score", getattr(config, "MIN_SCORE", 3) or 3)),
        int(profile.get("min_score", 0) or 0),
    )
    for symbol in symbols:
        if symbol not in symbol_filters:
            continue
        if symbol in get_blocked_symbols():
            continue
        if has_open_position(symbol):
            continue
        if config.TESTNET and is_symbol_in_error_cooldown(symbol):
            continue
        try:
            setup = evaluate_strategy_setup(symbol)
        except Exception as exc:
            print(f"CANDIDATE ERROR {symbol}: {exc}")
            continue
        if not setup.get("allowed"):
            continue
        score = int(setup.get("score", 0) or 0)
        if score < min_score:
            continue
        trend_alignment = sum(
            1 for key in ("trend_5m", "trend_15m", "trend_1h")
            if str(setup.get(key, "")).lower() == ("bullish" if str(setup.get("side", "")).upper() == "BUY" else "bearish")
        )
        ranked.append({
            "symbol": symbol,
            "score": score,
            "rsi_distance": abs(float(setup.get("rsi", 50.0) or 50.0) - 50.0),
            "atr_percent": float(setup.get("atr_percent", 0.0) or 0.0),
            "trend_alignment": trend_alignment,
        })
    ranked.sort(key=lambda item: (item["score"], item["trend_alignment"], -item["rsi_distance"], -item["atr_percent"]), reverse=True)
    return [item["symbol"] for item in ranked]


def auto_scan():
    while True:
        if not get_bot_running():
            time.sleep(1)
            continue

        candidate_symbols = build_ranked_trade_candidates(get_scan_symbols())
        for symbol in candidate_symbols:
            if not get_bot_running():
                print("BOT STOPPED")
                break
            if config.TESTNET and is_symbol_in_error_cooldown(symbol):
                continue
            execute_trade(symbol)
            if config.TESTNET:
                time.sleep(0.35)

        time.sleep(SCAN_INTERVAL)


def auto_close():
    while True:
        try:
            settings = get_runtime_settings()
            profile = get_strategy_profile(settings)
            auto_close_enabled = bool(settings.get("auto_close_enabled", True))
            auto_close_roi_percent = min(
                float(settings.get("auto_close_roi_percent", AUTO_CLOSE_ROI_PERCENT)),
                float(profile["auto_close_roi_percent"]),
            )
            hard_stop_roi = float(settings.get("hard_stop_roi_percent", HARD_STOP_ROI_PERCENT))
            trailing_enabled = bool(settings.get("trailing_enabled", True))
            if not auto_close_enabled:
                time.sleep(5)
                continue

            positions = call_binance("futures_position_information")
            active_symbols = {pos["symbol"] for pos in positions if float(pos["positionAmt"]) != 0}
            account_leverages = {}
            if active_symbols:
                try:
                    account_info = call_binance("futures_account")
                    for account_position in account_info.get("positions", []):
                        sym = account_position.get("symbol")
                        if sym in active_symbols:
                            account_leverages[sym] = int(float(account_position.get("leverage", 0) or 0))
                except Exception as exc:
                    print("Error fetching account info in auto_close:", exc)

            for pos in positions:
                amt = float(pos["positionAmt"])
                if amt == 0:
                    continue

                symbol = pos["symbol"]
                if symbol not in symbol_filters:
                    continue
                leverage = account_leverages.get(symbol)
                _, pct = calculate_position_roi_percent(pos, leverage=leverage)

                global_hard_stop_threshold = -abs(hard_stop_roi)
                if pct <= global_hard_stop_threshold:
                    success, message = close_position(symbol, reason="HARD_STOP")
                    if success:
                        print(f"HARD STOP {symbol} {pct:.2f}%")
                    else:
                        print(f"HARD STOP FAILED {symbol}: {message}")
                    continue

                trade = get_open_trade_record(symbol, adopt_if_missing=True, position=pos)
                if not trade:
                    print(f"AUTO CLOSE SKIP {symbol}: no OPEN trade record, ROI {pct:.2f}%")
                    continue

                risk_mode = str(trade.get("risk_mode", "normal") or "normal")
                high_target_mode = bool(profile.get("high_target_mode"))
                scalping_mode = bool(profile.get("scalping_mode"))
                if TEST_MINIMUM_TRADING_MODE:
                    partial_trigger = float("inf")
                    breakeven_trigger = float("inf")
                    trailing_trigger = max(TEST_TRAILING_TRIGGER_ROI_PERCENT, 0.01)
                    trailing_floor = max(TEST_TRAILING_CALLBACK_ROI_PERCENT, 0.01)
                    hard_stop_threshold = -abs(TEST_SL_PERCENT)
                elif high_target_mode:
                    partial_trigger = max(12.0, min(auto_close_roi_percent * 0.4, 35.0))
                    breakeven_trigger = max(4.0, partial_trigger * 0.45)
                    trailing_trigger = max(22.0, partial_trigger + 10.0)
                    trailing_floor = max(6.0, TRAILING_CALLBACK_ROI_PERCENT * 2.4)
                    hard_stop_threshold = min(hard_stop_roi, -10.0)
                elif scalping_mode:
                    partial_trigger = max(0.85, min(auto_close_roi_percent * float(profile["partial_tp_factor"]), 1.25))
                    breakeven_trigger = max(0.45, partial_trigger - float(profile["breakeven_buffer"]))
                    trailing_trigger = max(1.05, partial_trigger + float(profile["trailing_trigger_bonus"]))
                    trailing_floor = max(0.25, min(TRAILING_CALLBACK_ROI_PERCENT * float(profile["trailing_floor_factor"]), 0.45))
                    hard_stop_threshold = max(hard_stop_roi, -2.2)
                elif risk_mode == "cautious":
                    partial_trigger = max(1.8, min(auto_close_roi_percent * float(profile["partial_tp_factor"]), 3.0))
                    breakeven_trigger = max(0.9, partial_trigger - float(profile["breakeven_buffer"]))
                    trailing_trigger = max(2.7, partial_trigger + float(profile["trailing_trigger_bonus"]))
                    trailing_floor = max(0.55, TRAILING_CALLBACK_ROI_PERCENT * float(profile["trailing_floor_factor"]))
                    hard_stop_threshold = hard_stop_roi
                else:
                    partial_trigger = max(2.1, min(auto_close_roi_percent * (float(profile["partial_tp_factor"]) + 0.1), 4.0))
                    breakeven_trigger = max(1.0, partial_trigger - (float(profile["breakeven_buffer"]) + 0.15))
                    trailing_trigger = max(3.1, partial_trigger + float(profile["trailing_trigger_bonus"]))
                    trailing_floor = max(0.7, TRAILING_CALLBACK_ROI_PERCENT * (float(profile["trailing_floor_factor"]) + 0.05))
                    hard_stop_threshold = hard_stop_roi
                peak_roi = max(float(trade.get("peak_roi", 0) or 0), pct)
                partial_done = bool(trade.get("partial_tp_done"))
                breakeven_armed = bool(trade.get("breakeven_armed"))
                trailing_armed = bool(trade.get("trailing_armed"))

                update_open_trade_record(
                    symbol,
                    {
                        "peak_roi": round(peak_roi, 2),
                        "breakeven_armed": breakeven_armed or pct >= breakeven_trigger,
                        "trailing_armed": trailing_armed or pct >= trailing_trigger,
                    },
                )

                if scalping_mode and pct >= partial_trigger:
                    success, message = close_position(symbol, reason="SCALPING_TP")
                    if success:
                        print(f"SCALPING TP {symbol} {pct:.2f}%")
                    else:
                        print(f"SCALPING TP FAILED {symbol}: {message}")
                    continue

                if not partial_done and pct >= partial_trigger:
                    success, message = close_partial_position(symbol, fraction=PARTIAL_CLOSE_FRACTION, reason="PARTIAL_TP")
                    if success:
                        print(f"PARTIAL TP {symbol} {pct:.2f}%")
                    elif "Qty partial tidak valid" in str(message):
                        success, close_message = close_position(symbol, reason="PARTIAL_TP_FULL_CLOSE")
                        if success:
                            print(f"PARTIAL TP FULL CLOSE {symbol} {pct:.2f}%")
                        else:
                            print(f"PARTIAL TP FULL CLOSE FAILED {symbol}: {close_message}")
                    else:
                        print(f"PARTIAL TP FAILED {symbol}: {message}")
                    continue

                recovery_guard_active = (
                    int(get_history_monitor_state().get("recent_closed_trades", 0) or 0) >= 4
                    and float(get_history_monitor_state().get("recent_winrate", 100.0) or 100.0) < 45.0
                )
                breakeven_exit_floor = 0.08 if recovery_guard_active else 0.10
                breakeven_giveback = max(0.25 if recovery_guard_active else 0.35, breakeven_trigger * (0.4 if recovery_guard_active else 0.5))
                if (
                    not TEST_MINIMUM_TRADING_MODE
                    and (breakeven_armed or pct >= breakeven_trigger)
                    and peak_roi >= breakeven_trigger
                    and breakeven_exit_floor <= pct <= breakeven_giveback
                ):
                    success, message = close_position(symbol, reason="BREAKEVEN_EXIT")
                    if success:
                        print(f"BREAKEVEN EXIT {symbol} {pct:.2f}%")
                    else:
                        print(f"BREAKEVEN EXIT FAILED {symbol}: {message}")
                    continue

                if trailing_enabled and (trailing_armed or pct >= trailing_trigger) and pct <= (peak_roi - trailing_floor):
                    success, message = close_position(symbol, reason="TRAILING_STOP")
                    if success:
                        print(f"TRAILING STOP {symbol} {pct:.2f}% peak {peak_roi:.2f}%")
                    else:
                        print(f"TRAILING STOP FAILED {symbol}: {message}")
        except Exception as exc:
            print("Auto close error:", exc)

        time.sleep(5)


def realtime():
    while True:
        try:
            stats = calculate_stats()
            socketio.emit(
                "update_dashboard",
                {
                    "open_positions": get_current_positions(),
                    "stats": stats,
                    "time": datetime.now().strftime("%H:%M:%S"),
                },
            )
            socketio.emit("update_stats", stats)
        except Exception as exc:
            print("Realtime error:", exc)

        time.sleep(2)


@app.route("/")
@login_required
def index():
    return render_template("index.html", csrf_token=ensure_csrf_token())


@app.route("/config")
@login_required
def config_page():
    return render_template("config.html", csrf_token=ensure_csrf_token())


@app.route("/login", methods=["GET", "POST"])
def login():
    if is_authenticated():
        return redirect(url_for("index"))

    error_message = None
    next_url = request.args.get("next") or request.form.get("next") or url_for("index")
    csrf_token = ensure_csrf_token()

    if request.method == "POST":
        if not validate_csrf_request():
            error_message = "Sesi login tidak valid. Muat ulang halaman lalu coba lagi."
            return render_template("Login.html", error_message=error_message, next_url=next_url, csrf_token=csrf_token)

        username = str(request.form.get("username", "")).strip()
        password = str(request.form.get("password", ""))

        if credentials_valid(username, password):
            session.clear()
            session["authenticated"] = True
            session["username"] = username
            session["csrf_token"] = secrets.token_urlsafe(32)
            return redirect(next_url)

        error_message = "Username atau password salah."

    return render_template("Login.html", error_message=error_message, next_url=next_url, csrf_token=csrf_token)


@app.route("/logout", methods=["POST"])
