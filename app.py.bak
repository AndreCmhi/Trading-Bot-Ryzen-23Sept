def get_blocked_symbols():
    blocked = set(MANUAL_BLOCKED_SYMBOLS)
    settings = get_runtime_settings()
    if bool(settings.get("auto_blacklist_enabled", AUTO_BLACKLIST_ENABLED)):
        blocked.update(auto_blocked_symbols)
    return blocked


def load_runtime_settings():
    defaults = get_default_settings()
    with settings_lock:
        if not SETTINGS_FILE.exists():
            return defaults

        try:
            with SETTINGS_FILE.open("r", encoding="utf-8") as file:
                data = json.load(file)
                if not isinstance(data, dict):
                    return defaults
        except (json.JSONDecodeError, OSError) as exc:
            print(f"LOAD SETTINGS ERROR: {exc}")
            return defaults

    merged = defaults.copy()
    merged.update(data)
    return merged


def rebuild_auto_blacklist():
    global auto_blocked_symbols, auto_blacklist_details

    settings = get_runtime_settings()
    auto_blacklist_enabled = bool(settings.get("auto_blacklist_enabled", AUTO_BLACKLIST_ENABLED))
    min_trades = int(settings.get("auto_blacklist_min_trades", AUTO_BLACKLIST_MIN_TRADES) or AUTO_BLACKLIST_MIN_TRADES)
    min_loss_rate = float(settings.get("auto_blacklist_min_loss_rate", AUTO_BLACKLIST_MIN_LOSS_RATE) or AUTO_BLACKLIST_MIN_LOSS_RATE)
    max_total_pnl = float(settings.get("auto_blacklist_max_total_pnl", AUTO_BLACKLIST_MAX_TOTAL_PNL) or AUTO_BLACKLIST_MAX_TOTAL_PNL)
    min_hard_stop_rate = float(
        settings.get("auto_blacklist_min_hard_stop_rate", AUTO_BLACKLIST_MIN_HARD_STOP_RATE)
        or AUTO_BLACKLIST_MIN_HARD_STOP_RATE
    )
    min_consecutive_losses = int(
        settings.get("auto_blacklist_min_consecutive_losses", AUTO_BLACKLIST_MIN_CONSECUTIVE_LOSSES)
        or AUTO_BLACKLIST_MIN_CONSECUTIVE_LOSSES
    )

    if not auto_blacklist_enabled:
        auto_blocked_symbols = set()
        auto_blacklist_details = {}
        return auto_blocked_symbols

    grouped = {}
    for trade in load_trades():
        if not isinstance(trade, dict):
            continue
        if trade.get("status") != "CLOSED":
            continue
        symbol = str(trade.get("symbol") or "").strip().upper()
        if not symbol:
            continue
        grouped.setdefault(symbol, []).append(trade)

    generated = set()
    details = {}
    for symbol, trades in grouped.items():
        if len(trades) < min_trades:
            continue
        sorted_trades = sorted(trades, key=get_trade_reference_datetime)

        pnls = []
        hard_stop_like = 0
        for trade in sorted_trades:
            try:
                pnls.append(float(trade.get("pnl", 0) or 0))
            except (TypeError, ValueError):
                pnls.append(0.0)
            reason = str(trade.get("close_reason") or "").upper()
            if reason in {"HARD_STOP", "SYNC_CLOSE"}:
                hard_stop_like += 1

        losses = sum(1 for pnl in pnls if pnl < 0)
        loss_rate = losses / len(sorted_trades)
        total_pnl = sum(pnls)
        hard_stop_rate = hard_stop_like / len(sorted_trades)
        loss_streak = count_consecutive_losses(sorted_trades)
        blacklist_by_rate = (
            loss_rate >= min_loss_rate
            and total_pnl <= max_total_pnl
            and hard_stop_rate >= min_hard_stop_rate
        )
        blacklist_by_loss_cluster = (
            min_consecutive_losses > 0
            and losses >= min_consecutive_losses
            and loss_streak >= min_consecutive_losses
            and loss_rate >= min_loss_rate
            and total_pnl <= max_total_pnl
            and hard_stop_rate >= min(min_hard_stop_rate, 0.5)
        )

        if blacklist_by_rate or blacklist_by_loss_cluster:
            generated.add(symbol)
            details[symbol] = {
                "symbol": symbol,
                "count": len(sorted_trades),
                "losses": losses,
                "loss_rate": round(loss_rate, 2),
                "total_pnl": round(total_pnl, 2),
                "hard_stop_rate": round(hard_stop_rate, 2),
                "loss_streak": loss_streak,
                "avg_pnl": round((total_pnl / len(sorted_trades)), 2),
                "blacklist_reason": "loss-streak" if blacklist_by_loss_cluster else "loss-rate",
                "last_close_reason": str(sorted_trades[-1].get("close_reason") or "-"),
                "last_strategy_reason": str(sorted_trades[-1].get("strategy_reason") or "-"),
            }

    auto_blocked_symbols = generated
    auto_blacklist_details = details
    if symbol_filters:
        refresh_scan_symbols(force=True, discovered_symbols=list(symbol_filters.keys()))
    return generated


def save_runtime_settings(data):
