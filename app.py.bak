def normalize_strategy_mode(value):
    mode = str(value or "BALANCED").strip().upper()
    return mode if mode in STRATEGY_PROFILES else "BALANCED"


def normalize_trading_style(value):
    style = str(value or DEFAULT_TRADING_STYLE).strip().upper()
    return style if style in {"AUTO", "SCALPING", "TREND_FOLLOWING", "BREAKOUT"} else "AUTO"


def normalize_margin_mode(value):
    margin_mode = str(value or DEFAULT_MARGIN_MODE).strip().upper()
    return margin_mode if margin_mode in {"ISOLATED", "CROSSED"} else "ISOLATED"


def get_strategy_profile(settings=None):
    settings = settings or get_runtime_settings()
    mode = normalize_strategy_mode(settings.get("strategy_mode", "BALANCED"))
    profile = dict(STRATEGY_PROFILES[mode])
    profile["mode"] = mode
    regime = get_market_regime_state()
    label = str(regime.get("label", "UNKNOWN")).upper()
    profile["market_regime"] = label
    if mode == "TARGET_75":
        return profile

    if label == "SLUGGISH":
        profile["min_score"] = max(5, int(profile["min_score"]) - 1)
        profile["ai_min_confidence"] = max(0.54, float(profile["ai_min_confidence"]) - 0.02)
        profile["pullback_distance_percent"] = float(profile["pullback_distance_percent"]) + 0.06
        profile["entry_breakout_buffer_percent"] = max(0.01, float(profile["entry_breakout_buffer_percent"]) - 0.01)
        profile["min_ema_slope_5m"] = max(0.008, float(profile["min_ema_slope_5m"]) - 0.005)
        profile["min_ema_slope_15m"] = max(0.012, float(profile["min_ema_slope_15m"]) - 0.005)
        profile["min_ema_slope_1h"] = max(0.008, float(profile["min_ema_slope_1h"]) - 0.005)
        profile["auto_close_roi_percent"] = max(3.2, float(profile["auto_close_roi_percent"]) - 0.4)
    elif label == "ACTIVE":
        profile["min_score"] = int(profile["min_score"]) + 1
        profile["ai_min_confidence"] = min(0.7, float(profile["ai_min_confidence"]) + 0.02)
        profile["pullback_distance_percent"] = max(0.24, float(profile["pullback_distance_percent"]) - 0.03)
        profile["entry_breakout_buffer_percent"] = float(profile["entry_breakout_buffer_percent"]) + 0.01
        profile["auto_close_roi_percent"] = min(5.4, float(profile["auto_close_roi_percent"]) + 0.25)
    return profile


def set_market_regime_state(payload):
    global market_regime_state, market_regime_updated_at
    snapshot = dict(payload)
    snapshot["updated_at"] = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    with market_regime_lock:
        market_regime_state = snapshot
        market_regime_updated_at = time.time()
    return snapshot


def get_market_regime_state():
    with market_regime_lock:
        return dict(market_regime_state)


def set_history_monitor_state(payload):
    global history_monitor_state, history_monitor_updated_at
    snapshot = dict(payload)
    snapshot["updated_at"] = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    with history_monitor_lock:
        history_monitor_state = snapshot
        history_monitor_updated_at = time.time()
    return snapshot


def get_history_monitor_state():
    with history_monitor_lock:
        return dict(history_monitor_state)


def set_risk_guard_state(payload):
    global risk_guard_state, risk_guard_history
    snapshot = {
        "policy": str(payload.get("policy", "idle") or "idle"),
        "symbol": str(payload.get("symbol", "") or "").upper(),
        "reason": str(payload.get("reason", "Risk guard belum mengevaluasi trade.") or "").strip(),
        "checked_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "risk_multiplier": float(payload.get("risk_multiplier", 1.0) or 1.0),
        "confidence_boost": float(payload.get("confidence_boost", 0.0) or 0.0),
        "leverage_cap": payload.get("leverage_cap"),
    }
    with risk_guard_lock:
        risk_guard_state = snapshot
        risk_guard_history.append(dict(snapshot))
        risk_guard_history = risk_guard_history[-5:]
    return snapshot


def get_risk_guard_state():
    with risk_guard_lock:
        return dict(risk_guard_state)


def get_risk_guard_history():
    with risk_guard_lock:
        return [dict(item) for item in risk_guard_history[-5:]]


def classify_market_regime():
    benchmark_symbols = ("BTCUSDT", "ETHUSDT", "BNBUSDT", "SOLUSDT")
    atr_5m_values = []
    atr_15m_values = []
    momentum_15m_values = []

    for symbol in benchmark_symbols:
        try:
            closes_5m = get_klines(symbol, interval="5m", limit=80)
            closes_15m = get_klines(symbol, interval="15m", limit=80)
        except Exception as exc:
            print(f"MARKET REGIME DATA ERROR {symbol}: {exc}")
            continue

        atr_5m_values.append(calculate_atr_percent(closes_5m, 14))
        atr_15m_values.append(calculate_atr_percent(closes_15m, 14))
        if len(closes_15m) >= 16 and closes_15m[-16]:
            momentum_15m_values.append(abs(((closes_15m[-1] / closes_15m[-16]) - 1) * 100))

    if not atr_5m_values or not atr_15m_values:
        return {
            "label": "UNKNOWN",
            "summary": "Data market utama belum cukup.",
            "avg_atr_5m": 0.0,
            "avg_atr_15m": 0.0,
            "avg_momentum_15m": 0.0,
        }

    avg_atr_5m = sum(atr_5m_values) / len(atr_5m_values)
    avg_atr_15m = sum(atr_15m_values) / len(atr_15m_values)
    avg_momentum_15m = (
        sum(momentum_15m_values) / len(momentum_15m_values)
        if momentum_15m_values
        else 0.0
    )

    if avg_atr_5m < 0.22 and avg_momentum_15m < 0.75:
        label = "SLUGGISH"
        summary = "Market lesu: volatilitas tipis dan follow-through rendah."
    elif avg_atr_5m > 0.48 or avg_momentum_15m > 1.45:
        label = "ACTIVE"
        summary = "Market aktif: volatilitas dan dorongan harga sedang tinggi."
    else:
        label = "NORMAL"
        summary = "Market normal: peluang ada, tetapi belum eksplosif."

    return {
        "label": label,
        "summary": summary,
        "avg_atr_5m": round(avg_atr_5m, 4),
        "avg_atr_15m": round(avg_atr_15m, 4),
        "avg_momentum_15m": round(avg_momentum_15m, 4),
    }


def refresh_market_regime(force=False):
    now = time.time()
    with market_regime_lock:
        last_updated = market_regime_updated_at
    if not force and last_updated and (now - last_updated) < MARKET_REGIME_REFRESH_SECONDS:
        return get_market_regime_state()

    payload = classify_market_regime()
    return set_market_regime_state(payload)


def set_leverage(symbol, leverage=DEFAULT_LEVERAGE):
    try:
        client.futures_change_leverage(
            symbol=symbol,
            leverage=leverage
        )
    except Exception as exc:
        print(f"Leverage error {symbol}:", exc)


def ensure_margin_mode(symbol, margin_mode=DEFAULT_MARGIN_MODE):
    normalized_mode = normalize_margin_mode(margin_mode)
    try:
        client.futures_change_margin_type(
            symbol=symbol,
            marginType=normalized_mode,
        )
    except Exception as exc:
        message = str(exc)
        if "No need to change margin type" in message or "-4046" in message:
            return
        print(f"Margin mode error {symbol}:", exc)


def get_runtime_default_leverage():
    try:
        settings = get_runtime_settings()
        leverage = int(settings.get("default_leverage", DEFAULT_LEVERAGE))
        return leverage if leverage > 0 else DEFAULT_LEVERAGE
    except Exception:
        return DEFAULT_LEVERAGE


def get_position_leverage(position):
    raw_leverage = position.get("leverage")
    try:
        leverage = int(float(raw_leverage))
        if leverage > 0:
            return leverage
    except (TypeError, ValueError):
        pass

    symbol = position.get("symbol")
    if symbol:
        try:
            account_info = call_binance("futures_account")
            for account_position in account_info.get("positions", []):
                if account_position.get("symbol") != symbol:
                    continue
                account_leverage = int(float(account_position.get("leverage", 0) or 0))
                if account_leverage > 0:
                    return account_leverage
        except Exception as exc:
            print(f"Leverage lookup error {symbol}:", exc)

    return get_runtime_default_leverage()


def calculate_position_roi_percent(position, leverage=None):
    amt = float(position.get("positionAmt", 0) or 0)
    entry = float(position.get("entryPrice", 0) or 0)
    pnl = float(position.get("unRealizedProfit", 0) or 0)
    if leverage is None:
        leverage = get_position_leverage(position)
    margin = abs(amt * entry) / leverage if entry and leverage else 0
    roi_percent = (pnl / margin * 100) if margin > 0 else 0
    return margin, roi_percent

def is_authenticated():
    return session.get("authenticated") is True


def unauthorized_response():
    wants_json = request.path.startswith("/api/") or request.is_json
    if wants_json:
        return jsonify({"status": "error", "message": "Unauthorized"}), 401
    return redirect(url_for("login", next=request.path))


def login_required(view_func):
    @wraps(view_func)
    def wrapped(*args, **kwargs):
        if not is_authenticated():
            return unauthorized_response()
        return view_func(*args, **kwargs)

    return wrapped


def credentials_valid(username, password):
    return hmac.compare_digest(username, APP_USERNAME) and hmac.compare_digest(password, APP_PASSWORD)


def ensure_csrf_token():
    token = session.get("csrf_token")
    if not token:
        token = secrets.token_urlsafe(32)
        session["csrf_token"] = token
    return token


def validate_csrf_request():
    session_token = session.get("csrf_token")
    request_token = request.headers.get("X-CSRF-Token") or request.form.get("csrf_token")
    return bool(session_token and request_token and hmac.compare_digest(str(session_token), str(request_token)))


def csrf_protect(view_func):
    @wraps(view_func)
    def wrapped(*args, **kwargs):
        if request.method in {"POST", "PUT", "PATCH", "DELETE"} and not validate_csrf_request():
            return jsonify({"status": "error", "message": "CSRF token tidak valid."}), 403
        return view_func(*args, **kwargs)

    return wrapped


def load_exchange_filters():
    global symbol_filters
    blocked_symbols = get_blocked_symbols()
    info = client.futures_exchange_info()
    updated_filters = {}
    discovered_symbols = []

    for symbol_info in info["symbols"]:
        if symbol_info.get("status") != "TRADING":
            continue
        if symbol_info.get("contractType") != "PERPETUAL":
            continue
        if symbol_info.get("quoteAsset") != "USDT":
            continue

        filters = {item["filterType"]: item for item in symbol_info["filters"]}
        lot_filter = filters.get("MARKET_LOT_SIZE") or filters.get("LOT_SIZE")
        price_filter = filters.get("PRICE_FILTER")
        notional_filter = filters.get("MIN_NOTIONAL") or filters.get("NOTIONAL") or {}

        if not lot_filter or not price_filter:
            continue

        symbol = symbol_info["symbol"]
        if symbol in blocked_symbols:
            continue
        updated_filters[symbol] = {
            "stepSize": float(lot_filter["stepSize"]),
            "minQty": float(lot_filter.get("minQty", 0)),
            "tickSize": float(price_filter["tickSize"]),
            "minPrice": float(price_filter.get("minPrice", 0) or 0),
            "minNotional": float(
                notional_filter.get("notional")
                or notional_filter.get("minNotional")
                or 5
            ),
        }
        discovered_symbols.append(symbol)

    symbol_filters = updated_filters
    refresh_scan_symbols(force=True, discovered_symbols=discovered_symbols)


def build_ranked_scan_symbols(discovered_symbols):
    blocked_symbols = get_blocked_symbols()
    if UNRESTRICTED_SCAN_UNIVERSE:
        return [symbol for symbol in discovered_symbols if symbol not in blocked_symbols]

    if SYMBOL_SCAN_MODE != "ALL":
        configured = getattr(config, "SYMBOLS", []) or []
        return [symbol for symbol in configured if symbol in symbol_filters and symbol not in blocked_symbols]

    regime = refresh_market_regime()
    sluggish_market = str(regime.get("label", "UNKNOWN")).upper() == "SLUGGISH"

    try:
        tickers = client.futures_ticker()
    except Exception as exc:
        print(f"Ticker ranking error: {exc}")
        return discovered_symbols[:TOP_SYMBOL_LIMIT]

    ticker_map = {}
    for ticker in tickers:
        symbol = ticker.get("symbol")
        if symbol not in symbol_filters:
            continue
        ticker_map[symbol] = ticker

    ranked = []
    for symbol in discovered_symbols:
        ticker = ticker_map.get(symbol)
        if not ticker:
            continue

        try:
            last_price = float(ticker.get("lastPrice", 0) or 0)
            quote_volume = float(ticker.get("quoteVolume", 0) or 0)
        except (TypeError, ValueError):
            continue

        try:
            open_interest_payload = client.futures_open_interest(symbol=symbol)
            open_interest = float(open_interest_payload.get("openInterest", 0) or 0)
        except Exception as exc:
            print(f"Open interest error {symbol}: {exc}")
            open_interest = 0.0
        open_interest_notional = open_interest * last_price
        atr_percent_5m = 0.0
        if sluggish_market:
            try:
                atr_percent_5m = calculate_atr_percent(get_klines(symbol, interval="5m", limit=50), 14)
            except Exception as exc:
                print(f"ATR rank error {symbol}: {exc}")
                atr_percent_5m = 0.0
        ranked.append(
            {
                "symbol": symbol,
                "quote_volume": quote_volume,
                "open_interest_notional": open_interest_notional,
                "atr_percent_5m": atr_percent_5m,
            }
        )

    if sluggish_market:
        ranked.sort(
            key=lambda item: (item["atr_percent_5m"], item["open_interest_notional"], item["quote_volume"]),
            reverse=True,
        )
    else:
        ranked.sort(
            key=lambda item: (item["open_interest_notional"], item["quote_volume"]),
            reverse=True,
        )
    selected = [item["symbol"] for item in ranked[:TOP_SYMBOL_LIMIT] if item["symbol"] not in blocked_symbols]
    fallback = [symbol for symbol in discovered_symbols if symbol not in blocked_symbols][:TOP_SYMBOL_LIMIT]
    return selected or fallback


def refresh_scan_symbols(force=False, discovered_symbols=None):
    global scan_symbols, scan_symbols_updated_at
    now = time.time()
    if not force and scan_symbols and (now - scan_symbols_updated_at) < SYMBOL_RANK_REFRESH_SECONDS:
        return

    available_symbols = discovered_symbols or list(symbol_filters.keys())
    scan_symbols = build_ranked_scan_symbols(available_symbols)
    scan_symbols_updated_at = now


def get_scan_symbols():
    refresh_scan_symbols()
    return list(scan_symbols)


def round_step_size(value, step):
    return round(value - (value % step), 8)


def ceil_step_size(value, step):
    if step <= 0:
        return round(value, 8)
    return round(math.ceil((value - 1e-12) / step) * step, 8)


def round_tick_size(price, tick):
    return round(price - (price % tick), 8)


def load_trades():
    with trades_lock:
        if not DATA_FILE.exists():
            return []

        try:
            with DATA_FILE.open("r", encoding="utf-8") as file:
                return json.load(file)
        except (json.JSONDecodeError, OSError) as exc:
            print(f"LOAD TRADES ERROR: {exc}")
            return []


