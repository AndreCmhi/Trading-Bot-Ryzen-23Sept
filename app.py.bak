def ensure_open_trade_record(symbol, position=None):
    symbol = str(symbol or "")
    if not symbol:
        return None

    if position is None:
        position = get_open_position(symbol)
    if not position:
        return None

    amt = float(position.get("positionAmt", 0) or 0)
    if amt == 0:
        return None

    with trades_lock:
        trades = []
        if DATA_FILE.exists():
            try:
                with DATA_FILE.open("r", encoding="utf-8") as file:
                    trades = json.load(file)
            except (json.JSONDecodeError, OSError) as exc:
                print(f"LOAD TRADES ERROR: {exc}")
                trades = []

        for trade in reversed(trades):
            if trade.get("symbol") == symbol and trade.get("status") == "OPEN":
                return trade

        entry = float(position.get("entryPrice", 0) or 0)
        adopted_trade = {
            "symbol": symbol,
            "side": "BUY" if amt > 0 else "SELL",
            "price": entry,
            "qty": abs(amt),
            "score": 0,
            "rsi": 0,
            "ai_confidence": None,
            "ai_reason": "Adopted live exchange position without local OPEN record.",
            "ai_mode": "sync-adopt",
            "risk_mode": "normal",
            "strategy_family": "ADOPTED",
            "strategy_reason": "Adopted from live exchange state.",
            "market_regime": get_market_regime_state().get("label", "UNKNOWN"),
            "trend_1h": None,
            "trend_15m": None,
            "trend_5m": None,
            "atr_percent": 0.0,
            "risk_percent": 0.0,
            "risk_amount": 0.0,
            "risk_reward_ratio": 0.0,
            "position_notional": round(abs(amt) * entry, 4),
            "margin_required": 0.0,
            "suggested_leverage": get_position_leverage(position),
            "preferred_margin_mode": get_runtime_settings().get("preferred_margin_mode", "ISOLATED"),
            "tp_price": None,
            "sl_price": None,
            "tp_percent": 0.0,
            "sl_percent": 0.0,
            "partial_tp_done": False,
            "peak_roi": 0.0,
            "breakeven_armed": False,
            "trailing_armed": False,
            "status": "OPEN",
            "time": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            "pnl": 0,
        }
        trades.append(adopted_trade)
        with DATA_FILE.open("w", encoding="utf-8") as file:
            json.dump(trades, file, indent=4)

    rebuild_auto_blacklist()
    print(f"ADOPTED OPEN POSITION {symbol}: local OPEN trade record dibuat dari posisi exchange.")
    return adopted_trade


def save_trades(trades):
    with trades_lock:
        with DATA_FILE.open("w", encoding="utf-8") as file:
            json.dump(trades, file, indent=4)
    rebuild_auto_blacklist()


def parse_trade_datetime(value):
    if not value:
        return None

    try:
        return datetime.strptime(str(value), "%Y-%m-%d %H:%M:%S")
    except ValueError:
        return None


def get_trade_reference_datetime(trade):
    return (
        parse_trade_datetime(trade.get("closed_time"))
        or parse_trade_datetime(trade.get("time"))
        or datetime.min
    )


def get_realized_pnl_for_trade(symbol, opened_at):
    opened_dt = parse_trade_datetime(opened_at)
    start_time = int(opened_dt.timestamp() * 1000) if opened_dt else None

    income_rows = []
    income_fn = getattr(client, "futures_income_history", None)
    if callable(income_fn):
        try:
            income_rows = income_fn(
                symbol=symbol,
                incomeType="REALIZED_PNL",
                startTime=start_time,
                limit=50,
            )
        except Exception as exc:
            print(f"Income history error {symbol}:", exc)

    if not income_rows:
        account_trades_fn = getattr(client, "futures_account_trades", None)
        if callable(account_trades_fn):
            try:
                account_trades = account_trades_fn(symbol=symbol, startTime=start_time, limit=100)
                realized_pnl = 0.0
                latest_time = None
                for row in account_trades:
                    realized_value = float(row.get("realizedPnl", 0) or 0)
                    trade_time = row.get("time")
                    realized_pnl += realized_value
                    if trade_time:
                        latest_time = max(latest_time or trade_time, trade_time)
                if realized_pnl or latest_time:
                    return realized_pnl, latest_time
            except Exception as exc:
                print(f"Account trades fallback error {symbol}:", exc)

    if not income_rows:
        return 0.0, None

    realized_pnl = 0.0
    latest_time = None
    for row in income_rows:
        income_time = row.get("time")
        income_value = float(row.get("income", 0) or 0)
        realized_pnl += income_value
        if income_time:
            latest_time = max(latest_time or income_time, income_time)

    closed_time = (
        datetime.fromtimestamp(latest_time / 1000).strftime("%Y-%m-%d %H:%M:%S")
        if latest_time
        else datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    )
    return round(realized_pnl, 2), closed_time


def sync_closed_trades():
    trades = load_trades()
    if not trades:
        return trades

    live_symbols = {position.get("symbol") for position in get_current_positions()}
    updated = False

    for trade in trades:
        if trade.get("status") != "OPEN":
            continue

        symbol = trade.get("symbol")
        if symbol in live_symbols:
            continue

        realized_pnl, closed_time = get_realized_pnl_for_trade(symbol, trade.get("time"))
        trade["status"] = "CLOSED"
        trade["pnl"] = realized_pnl
        trade["close_reason"] = trade.get("close_reason") or "SYNC_CLOSE"
        trade["closed_time"] = closed_time
        trade["close_price"] = round(float(trade.get("close_price", 0) or 0), 4)
        updated = True

    if updated:
        trades.sort(key=get_trade_reference_datetime)
        save_trades(trades)

    return trades


def get_open_position_count(trackable_only=True):
    positions = get_current_positions()
    if not trackable_only:
        return len(positions)
    return sum(1 for position in positions if str(position.get("symbol", "") or "") in symbol_filters)


def get_open_position_side_counts(trackable_only=True):
    counts = {"BUY": 0, "SELL": 0}
    for position in get_current_positions():
        symbol = str(position.get("symbol", "") or "")
        if trackable_only and symbol not in symbol_filters:
            continue
        side = str(position.get("side", "") or "").upper()
        if side in counts:
            counts[side] += 1
    return counts


def get_bot_running():
    with status_lock:
        return bot_running


def get_bot_status_payload():
    with status_lock:
        current_status = bot_running
        stop_reason = bot_stop_reason
        stop_source = bot_stop_source

    payload = {
        "running": current_status,
        "label": "RUNNING" if current_status else "STOPPED",
        "updated_at": datetime.now().strftime("%H:%M:%S"),
    }
    if stop_reason:
        payload["reason"] = stop_reason
        payload["source"] = stop_source
    return payload


def set_bot_running(value, reason="", source="manual"):
    global bot_running, bot_stop_reason, bot_stop_source
    with status_lock:
        bot_running = bool(value)
        current_status = bot_running
        if current_status:
            bot_stop_reason = ""
            bot_stop_source = source
        else:
            bot_stop_reason = str(reason or "Bot dihentikan.")
            bot_stop_source = str(source or "manual")

    payload = get_bot_status_payload()
    socketio.emit("bot_status", payload)
    return current_status


def pause_bot_by_guard(reason):
    reason = str(reason or "Risk guard menghentikan bot.").strip()
    already_running = get_bot_running()
    current_status = set_bot_running(False, reason=reason, source="risk-guard")
    if already_running:
        print(f"BOT AUTO-PAUSED: {reason}")
    return current_status


def pause_and_flatten_by_guard(reason):
    pause_bot_by_guard(reason)
    settings = get_runtime_settings()
    if not bool(settings.get("auto_close_positions_on_guard_halt", AUTO_CLOSE_POSITIONS_ON_GUARD_HALT)):
        return None

    flatten_reason = f"RISK_GUARD_HALT: {reason}"
    result = close_all_positions(reason=flatten_reason)
    closed_count = int(result.get("closed_count", 0) or 0)
    failed_count = int(result.get("failed_count", 0) or 0)
    print(
        "BOT AUTO-FLATTEN:"
        f" closed={closed_count} failed={failed_count} reason={flatten_reason}"
    )
    socketio.emit(
        "risk_guard_halt",
        {
            "reason": reason,
            "closed_count": closed_count,
            "failed_count": failed_count,
            "updated_at": datetime.now().strftime("%H:%M:%S"),
        },
    )
    return result


def calculate_stats():
    trades = sync_closed_trades()
    today = datetime.now().strftime("%Y-%m-%d")
    settings = get_runtime_settings()
    live_open_positions = get_current_positions()

    total_pnl = 0.0
    closed_count = 0
    win_count = 0
    loss_count = 0
    breakeven_count = 0
    winning_pnl_total = 0.0
    losing_pnl_total = 0.0
    total_trades_today = 0
    open_profit_count = 0
    open_loss_count = 0
    open_breakeven_count = 0

    for trade in trades:
        trade_time = str(trade.get("time", ""))
        if trade_time.startswith(today):
            total_trades_today += 1

        if trade.get("status") == "CLOSED":
            closed_time = str(trade.get("closed_time", ""))
            if not closed_time.startswith(today):
                continue

            pnl = float(trade.get("pnl", 0) or 0)
            total_pnl += pnl

            closed_count += 1
            if pnl > 0:
                win_count += 1
                winning_pnl_total += pnl
            elif pnl < 0:
                loss_count += 1
                losing_pnl_total += pnl
            else:
                breakeven_count += 1

    total_open_margin = 0.0
    for position in live_open_positions:
        pnl = float(position.get("pnl", 0) or 0)
        margin = float(position.get("margin", 0) or 0)
        total_open_margin += margin
        if pnl > 0:
            open_profit_count += 1
        elif pnl < 0:
            open_loss_count += 1
        else:
            open_breakeven_count += 1

    margin_balance = get_balance()

    winrate = round((win_count / closed_count) * 100, 2) if closed_count else 0
    closed_trades_sorted = sorted(
        [trade for trade in trades if trade.get("status") == "CLOSED"],
        key=get_trade_reference_datetime,
    )
    consecutive_losses = count_consecutive_losses(closed_trades_sorted)
    return {
        "total_pnl": round(total_pnl, 2),
        "winrate": winrate,
        "auto_close": bool(settings.get("auto_close_enabled", True)),
        "auto_close_roi_percent": float(settings.get("auto_close_roi_percent", AUTO_CLOSE_ROI_PERCENT)),
        "closed_trades": closed_count,
        "open_trades": len(live_open_positions),
        "consecutive_losses": consecutive_losses,
        "total_trades_today": total_trades_today,
        "total_trades_all": len(trades),
        "winning_trades_today": win_count,
        "losing_trades_today": loss_count,
        "breakeven_trades_today": breakeven_count,
        "winning_pnl_today": round(winning_pnl_total, 2),
        "losing_pnl_today": round(losing_pnl_total, 2),
        "open_profit_trades": open_profit_count,
        "open_loss_trades": open_loss_count,
        "open_breakeven_trades": open_breakeven_count,
        "total_open_margin": round(total_open_margin, 2),
        "margin_balance": round(margin_balance, 2),
    }


def calculate_symbol_trade_stats(symbol, trades=None):
    symbol = str(symbol or "").upper().strip()
    if not symbol:
        return {
            "symbol_trades_today": 0,
            "symbol_losses_today": 0,
            "symbol_consecutive_losses": 0,
            "minutes_since_last_symbol_loss": None,
            "minutes_since_last_symbol_hard_stop": None,
        }

    trades = trades if trades is not None else sync_closed_trades()
    today = datetime.now().strftime("%Y-%m-%d")
    symbol_trades_today = 0
    symbol_losses_today = 0
    symbol_closed = []
    last_loss_time = None
    last_hard_stop_time = None

    for trade in trades:
        if str(trade.get("symbol", "")).upper() != symbol:
            continue

        trade_time = str(trade.get("time", ""))
        if trade_time.startswith(today):
            symbol_trades_today += 1

        if trade.get("status") != "CLOSED":
            continue

        symbol_closed.append(trade)
        closed_time = str(trade.get("closed_time", ""))
        pnl = float(trade.get("pnl", 0) or 0)
        if closed_time.startswith(today) and pnl < 0:
            symbol_losses_today += 1
        if pnl < 0:
            trade_closed_dt = parse_trade_datetime(closed_time) or parse_trade_datetime(trade_time)
            if trade_closed_dt and (last_loss_time is None or trade_closed_dt > last_loss_time):
                last_loss_time = trade_closed_dt
        if str(trade.get("close_reason", "")).upper() == "HARD_STOP":
            trade_hard_stop_dt = parse_trade_datetime(closed_time) or parse_trade_datetime(trade_time)
            if trade_hard_stop_dt and (last_hard_stop_time is None or trade_hard_stop_dt > last_hard_stop_time):
                last_hard_stop_time = trade_hard_stop_dt

    symbol_closed.sort(key=get_trade_reference_datetime)
    symbol_consecutive_losses = count_consecutive_losses(symbol_closed)
    minutes_since_last_symbol_loss = None
    minutes_since_last_symbol_hard_stop = None
    if last_loss_time is not None:
        minutes_since_last_symbol_loss = round(
            max((datetime.now() - last_loss_time).total_seconds(), 0) / 60,
            2,
        )
    if last_hard_stop_time is not None:
        minutes_since_last_symbol_hard_stop = round(
            max((datetime.now() - last_hard_stop_time).total_seconds(), 0) / 60,
            2,
        )

    return {
        "symbol_trades_today": symbol_trades_today,
        "symbol_losses_today": symbol_losses_today,
        "symbol_consecutive_losses": symbol_consecutive_losses,
        "minutes_since_last_symbol_loss": minutes_since_last_symbol_loss,
        "minutes_since_last_symbol_hard_stop": minutes_since_last_symbol_hard_stop,
    }


def calculate_recent_trade_stats(trades=None, lookback_minutes=60):
    trades = trades if trades is not None else sync_closed_trades()
    cutoff = datetime.now().timestamp() - (lookback_minutes * 60)
    trades_last_hour = 0
    losses_last_hour = 0
    pnl_last_hour = 0.0
    last_loss_time = None

    for trade in trades:
        trade_dt = get_trade_reference_datetime(trade)
        if not trade_dt or trade_dt.timestamp() < cutoff:
            continue

        trades_last_hour += 1
        if trade.get("status") != "CLOSED":
            continue

        pnl = float(trade.get("pnl", 0) or 0)
        pnl_last_hour += pnl
        if pnl < 0:
            losses_last_hour += 1
            if last_loss_time is None or trade_dt > last_loss_time:
                last_loss_time = trade_dt

    minutes_since_last_loss = None
    if last_loss_time is not None:
        minutes_since_last_loss = round(
            max((datetime.now() - last_loss_time).total_seconds(), 0) / 60,
            2,
        )

    return {
        "trades_last_hour": trades_last_hour,
        "losses_last_hour": losses_last_hour,
        "pnl_last_hour": round(pnl_last_hour, 2),
        "minutes_since_last_loss": minutes_since_last_loss,
    }


def build_recent_trade_performance_context(trades=None, lookback_count=ADAPTIVE_PERFORMANCE_LOOKBACK_TRADES):
    trades = trades if trades is not None else sync_closed_trades()
    closed_trades = sorted(
        [trade for trade in trades if trade.get("status") == "CLOSED"],
        key=get_trade_reference_datetime,
    )
    recent_closed = closed_trades[-lookback_count:] if len(closed_trades) > lookback_count else closed_trades

    def build_bucket(items):
        count = len(items)
        wins = sum(1 for trade in items if float(trade.get("pnl", 0) or 0) > 0)
        losses = sum(1 for trade in items if float(trade.get("pnl", 0) or 0) < 0)
        hard_stops = sum(
            1
            for trade in items
            if str(trade.get("close_reason", "")).upper() == "HARD_STOP"
        )
        total_pnl = sum(float(trade.get("pnl", 0) or 0) for trade in items)
        consecutive_losses = count_consecutive_losses(items)
        return {
            "count": count,
            "wins": wins,
            "losses": losses,
            "winrate": round((wins / count) * 100, 2) if count else 0.0,
            "loss_rate": round((losses / count), 4) if count else 0.0,
            "hard_stop_rate": round((hard_stops / count), 4) if count else 0.0,
            "consecutive_losses": consecutive_losses,
            "total_pnl": round(total_pnl, 2),
        }

    side_stats = {}
    for side in ("BUY", "SELL"):
        side_items = [trade for trade in recent_closed if str(trade.get("side", "")).upper() == side]
        side_stats[side] = build_bucket(side_items)

    strategy_stats = {}
    for family in ("SCALPING", "TREND_FOLLOWING", "BREAKOUT"):
        strategy_items = [
            trade
            for trade in recent_closed
            if str(trade.get("strategy_family", "") or "").upper() == family
        ]
        strategy_stats[family] = build_bucket(strategy_items)

    buy_scalping_items = [
        trade
        for trade in recent_closed
        if str(trade.get("side", "")).upper() == "BUY"
        and str(trade.get("strategy_family", "") or "").upper() == "SCALPING"
    ]
    buy_scalping_bucket = build_bucket(buy_scalping_items)
    buy_scalping_pause_active = (
        buy_scalping_bucket["count"] >= BUY_SCALPING_PAUSE_MIN_TRADES
        and buy_scalping_bucket["winrate"] <= BUY_SCALPING_PAUSE_MAX_WINRATE
        and buy_scalping_bucket["total_pnl"] <= BUY_SCALPING_PAUSE_MAX_TOTAL_PNL
        and buy_scalping_bucket["hard_stop_rate"] >= BUY_SCALPING_PAUSE_MAX_HARD_STOP_RATE
    )
    adaptive_pauses = {
        "buy_scalping": {
            "active": buy_scalping_pause_active,
            "count": buy_scalping_bucket["count"],
            "winrate": buy_scalping_bucket["winrate"],
            "hard_stop_rate": buy_scalping_bucket["hard_stop_rate"],
            "total_pnl": buy_scalping_bucket["total_pnl"],
            "reason": (
                "BUY scalping dipause sementara karena winrate rendah dan hard stop terlalu tinggi."
                if buy_scalping_pause_active
                else ""
            ),
        }
    }

    return {
        "lookback_count": len(recent_closed),
        "overall": build_bucket(recent_closed),
        "by_side": side_stats,
        "by_strategy": strategy_stats,
        "patterns": {
            "BUY_SCALPING": buy_scalping_bucket,
        },
        "adaptive_pauses": adaptive_pauses,
    }


def safe_float(value, default=0.0):
    try:
        return float(value or 0)
    except (TypeError, ValueError):
        return default


def build_trade_performance_row(key, label, bucket):
    count = int(bucket.get("count", 0) or 0)
    wins = int(bucket.get("wins", 0) or 0)
    losses = int(bucket.get("losses", 0) or 0)
    total_pnl = safe_float(bucket.get("total_pnl", 0))
    winrate = round((wins / count) * 100, 2) if count else 0.0
    loss_rate = round((losses / count), 4) if count else 0.0
    return {
        "key": key,
        "label": label,
        "count": count,
        "wins": wins,
        "losses": losses,
        "winrate": winrate,
        "loss_rate": loss_rate,
        "total_pnl": round(total_pnl, 2),
        "avg_pnl": round((total_pnl / count), 2) if count else 0.0,
    }


def build_trade_history_monitor(trades=None, settings=None):
    settings = settings or get_runtime_settings()
    source_trades = trades if trades is not None else load_trades()
    closed_trades = sorted(
        [trade for trade in source_trades if trade.get("status") == "CLOSED"],
        key=get_trade_reference_datetime,
    )
    analysis_window = closed_trades[-60:] if len(closed_trades) > 60 else closed_trades
    recent_closed = analysis_window[-20:] if len(analysis_window) > 20 else analysis_window

    recent_count = len(recent_closed)
    recent_pnl = round(sum(safe_float(trade.get("pnl", 0)) for trade in recent_closed), 2)
    recent_wins = sum(1 for trade in recent_closed if safe_float(trade.get("pnl", 0)) > 0)
    recent_losses = sum(1 for trade in recent_closed if safe_float(trade.get("pnl", 0)) < 0)
    recent_winrate = round((recent_wins / recent_count) * 100, 2) if recent_count else 0.0
    recent_loss_rate = round((recent_losses / recent_count), 4) if recent_count else 0.0
    recent_hard_stops = sum(
        1
        for trade in recent_closed
        if str(trade.get("close_reason", "")).upper() == "HARD_STOP"
    )
    recent_hard_stop_rate = round((recent_hard_stops / recent_count), 4) if recent_count else 0.0
    recent_manual_loss_closes = sum(
        1
        for trade in recent_closed
        if str(trade.get("close_reason", "")).upper().startswith("MANUAL")
        and safe_float(trade.get("pnl", 0)) < 0
    )
    recent_profit_leaks = sum(
        1
        for trade in recent_closed
        if safe_float(trade.get("peak_roi", 0)) >= 1.5 and safe_float(trade.get("pnl", 0)) <= 0
    )

    symbol_groups = {}
    hour_groups = {}
    reason_groups = {}
    score_groups = {
        "LOW": {"count": 0, "wins": 0, "losses": 0, "total_pnl": 0.0},
        "MID": {"count": 0, "wins": 0, "losses": 0, "total_pnl": 0.0},
        "HIGH": {"count": 0, "wins": 0, "losses": 0, "total_pnl": 0.0},
    }

    for trade in analysis_window:
        pnl = safe_float(trade.get("pnl", 0))
        symbol = str(trade.get("symbol", "")).upper().strip() or "-"
        close_reason = str(trade.get("close_reason", "")).upper().strip() or "UNKNOWN"
        opened_dt = parse_trade_datetime(trade.get("time")) or get_trade_reference_datetime(trade)
        hour = opened_dt.hour if opened_dt else -1
        score = int(safe_float(trade.get("score", 0)))

        symbol_groups.setdefault(symbol, {"count": 0, "wins": 0, "losses": 0, "total_pnl": 0.0})
        symbol_groups[symbol]["count"] += 1
        symbol_groups[symbol]["total_pnl"] += pnl
        if pnl > 0:
            symbol_groups[symbol]["wins"] += 1
        elif pnl < 0:
            symbol_groups[symbol]["losses"] += 1

        hour_groups.setdefault(hour, {"count": 0, "wins": 0, "losses": 0, "total_pnl": 0.0})
        hour_groups[hour]["count"] += 1
        hour_groups[hour]["total_pnl"] += pnl
        if pnl > 0:
            hour_groups[hour]["wins"] += 1
        elif pnl < 0:
            hour_groups[hour]["losses"] += 1

        reason_groups.setdefault(close_reason, {"count": 0, "wins": 0, "losses": 0, "total_pnl": 0.0})
        reason_groups[close_reason]["count"] += 1
        reason_groups[close_reason]["total_pnl"] += pnl
        if pnl > 0:
            reason_groups[close_reason]["wins"] += 1
        elif pnl < 0:
            reason_groups[close_reason]["losses"] += 1

        if score <= 5:
            score_bucket = "LOW"
        elif score <= 7:
            score_bucket = "MID"
        else:
            score_bucket = "HIGH"
        score_groups[score_bucket]["count"] += 1
        score_groups[score_bucket]["total_pnl"] += pnl
        if pnl > 0:
            score_groups[score_bucket]["wins"] += 1
        elif pnl < 0:
            score_groups[score_bucket]["losses"] += 1

    symbol_rows = [
        build_trade_performance_row(symbol, symbol, bucket)
        for symbol, bucket in symbol_groups.items()
        if bucket.get("count", 0) > 0
    ]
    symbol_rows.sort(key=lambda item: (item["total_pnl"], item["loss_rate"], -item["count"]))
    worst_symbols = [item for item in symbol_rows if item["count"] >= 2][:5]
    best_symbols = sorted(
        [item for item in symbol_rows if item["count"] >= 2],
        key=lambda item: (item["total_pnl"], item["winrate"], item["count"]),
        reverse=True,
    )[:5]

    hour_rows = []
    for hour, bucket in hour_groups.items():
        label = f"{hour:02d}:00-{hour:02d}:59" if hour >= 0 else "Unknown"
        row = build_trade_performance_row(str(hour), label, bucket)
        row["hour"] = hour
        hour_rows.append(row)
    worst_hours = sorted(
        [item for item in hour_rows if item["count"] >= 2],
        key=lambda item: (item["total_pnl"], item["loss_rate"], -item["count"]),
    )[:4]
    best_hours = sorted(
        [item for item in hour_rows if item["count"] >= 2],
        key=lambda item: (item["total_pnl"], item["winrate"], item["count"]),
        reverse=True,
    )[:4]

    close_reasons = sorted(
        [
            build_trade_performance_row(reason, reason, bucket)
            for reason, bucket in reason_groups.items()
            if bucket.get("count", 0) > 0
        ],
        key=lambda item: (item["count"], abs(item["total_pnl"])),
        reverse=True,
    )[:6]

    score_bands = [
        build_trade_performance_row("LOW", "Score <= 5", score_groups["LOW"]),
        build_trade_performance_row("MID", "Score 6-7", score_groups["MID"]),
        build_trade_performance_row("HIGH", "Score >= 8", score_groups["HIGH"]),
    ]
    score_bands = [item for item in score_bands if item["count"] > 0]

    current_mode = normalize_strategy_mode(settings.get("strategy_mode", "BALANCED"))
    current_min_score = int(settings.get("min_score", getattr(config, "MIN_SCORE", 3) or 3))
    current_max_open = int(settings.get("max_open_positions", MAX_OPEN_POSITIONS))
    current_leverage = int(settings.get("default_leverage", DEFAULT_LEVERAGE))
    suggested_settings = {}
    recommendations = []

    if recent_count >= 6 and (recent_pnl < 0 or recent_winrate < 45):
        target_mode = "PRECISION" if recent_winrate < 40 or recent_pnl <= -1 else "BALANCED"
        target_min_score = min(10, max(current_min_score, 7) + (1 if recent_winrate < 35 else 0))
        target_max_open = max(2, current_max_open - (2 if current_max_open > 4 else 1))
        if target_mode != current_mode:
            suggested_settings["strategy_mode"] = target_mode
        if target_min_score > current_min_score:
            suggested_settings["min_score"] = target_min_score
        if target_max_open < current_max_open:
            suggested_settings["max_open_positions"] = target_max_open
        recommendations.append(
            {
                "type": "tighten-entry",
                "tone": "warning",
                "title": "Perketat entry sementara",
                "detail": (
                    f"{recent_count} closed trade terakhir menghasilkan {recent_pnl:.2f} USDT "
                    f"dengan winrate {recent_winrate:.2f}%. Saran: naikkan selektivitas entry "
                    f"dan kurangi posisi aktif bersamaan."
                ),
            }
        )

    if recent_count >= 6 and recent_hard_stop_rate >= 0.35:
        target_leverage = max(5, current_leverage - (5 if current_leverage > 12 else 2))
        if target_leverage < current_leverage:
            suggested_settings["default_leverage"] = target_leverage
        recommendations.append(
            {
                "type": "reduce-leverage",
                "tone": "warning",
                "title": "Turunkan leverage default",
                "detail": (
                    f"Hard stop muncul pada {recent_hard_stops} dari {recent_count} trade terakhir. "
                    f"Leverage lebih rendah membantu menahan drawdown saat setup belum stabil."
                ),
            }
        )

    flagged_symbols = [
        item["label"]
        for item in worst_symbols
        if item["count"] >= 3 and item["loss_rate"] >= 0.67 and item["total_pnl"] < 0
    ][:3]
    if flagged_symbols:
        recommendations.append(
            {
                "type": "block-symbols",
                "tone": "danger",
                "title": "Kurangi eksposur simbol yang konsisten rugi",
                "detail": (
                    "Simbol ini paling sering menggerus PNL pada window terbaru: "
                    + ", ".join(flagged_symbols)
                    + "."
                ),
            }
        )

    flagged_hours = [
        item["hour"]
        for item in worst_hours
        if item["hour"] >= 0 and item["count"] >= 2 and item["loss_rate"] >= 0.6 and item["total_pnl"] < 0
    ][:3]
    if flagged_hours:
        hour_text = ", ".join(f"{hour:02d}:00" for hour in flagged_hours)
        recommendations.append(
            {
                "type": "avoid-hours",
                "tone": "warning",
                "title": "Batasi entry di jam yang lemah",
                "detail": f"Jam dengan performa terburuk pada history terbaru: {hour_text}.",
            }
        )

    if recent_profit_leaks >= 2:
        recommendations.append(
            {
                "type": "protect-winners",
                "tone": "warning",
                "title": "Kunci profit lebih cepat",
                "detail": (
                    f"Ada {recent_profit_leaks} trade yang sempat punya peak ROI sehat "
                    "namun berakhir nol atau rugi. Pertahankan partial TP dan breakeven "
                    "lebih disiplin saat posisi sudah hijau."
                ),
            }
        )

    if recent_count >= 6 and recent_pnl > 0 and recent_winrate >= 55:
        focus_symbols = [item["label"] for item in best_symbols[:2]]
        if focus_symbols:
            recommendations.append(
                {
                    "type": "press-advantage",
                    "tone": "success",
                    "title": "Fokus pada setup yang sudah bekerja",
                    "detail": (
                        f"Winrate {recent_winrate:.2f}% dengan PNL {recent_pnl:.2f} USDT. "
                        f"Pertahankan mode saat ini dan prioritaskan simbol {', '.join(focus_symbols)}."
                    ),
                }
            )

    return {
        "analysis_window_trades": len(analysis_window),
        "closed_trades": len(closed_trades),
        "recent_closed_trades": recent_count,
        "recent_pnl": recent_pnl,
        "recent_winrate": recent_winrate,
        "recent_loss_rate": recent_loss_rate,
        "recent_hard_stop_rate": recent_hard_stop_rate,
        "recent_manual_loss_closes": recent_manual_loss_closes,
        "recent_profit_leaks": recent_profit_leaks,
        "recommendations": recommendations,
        "suggested_settings": suggested_settings or None,
        "has_setting_changes": bool(suggested_settings),
        "suggested_blocked_symbols": flagged_symbols,
        "suggested_avoid_hours": flagged_hours,
        "best_symbols": best_symbols,
        "worst_symbols": worst_symbols,
        "best_hours": best_hours,
        "worst_hours": worst_hours,
        "close_reasons": close_reasons,
        "score_bands": score_bands,
    }


def refresh_trade_history_monitor(force=False, emit=False):
    now = time.time()
    with history_monitor_lock:
        last_updated = history_monitor_updated_at
    if not force and last_updated and (now - last_updated) < HISTORY_MONITOR_REFRESH_SECONDS:
        state = get_history_monitor_state()
        if emit:
            socketio.emit("history_monitor", state)
        return state

    trades = sync_closed_trades()
    state = set_history_monitor_state(build_trade_history_monitor(trades=trades))
    if emit:
        socketio.emit("history_monitor", state)
    return state


def emit_stats():
    socketio.emit("update_stats", calculate_stats())


def sync_binance_time(force=False):
    global binance_time_offset_ms, binance_time_synced_at
    now = time.time()
    if not force and binance_time_synced_at and (now - binance_time_synced_at) < 300:
        return binance_time_offset_ms
    try:
        server_time_payload = client.get_server_time()
        server_time = int(server_time_payload.get("serverTime", 0) or 0)
        local_time = int(time.time() * 1000)
        binance_time_offset_ms = server_time - local_time
        client.timestamp_offset = binance_time_offset_ms
        binance_time_synced_at = now
    except Exception as exc:
        print(f"BINANCE TIME SYNC ERROR: {exc}")
    return binance_time_offset_ms


def _is_timestamp_error(exc):
    text = str(exc)
    return "-1021" in text or "recvWindow" in text or "Timestamp for this request" in text


def _is_retryable_network_error(exc):
    text = str(exc).lower()
    markers = [
        "read timed out",
        "connect timeout",
        "connection aborted",
        "connection reset",
        "temporarily unavailable",
        "enotfound",
        "name or service not known",
        "max retries exceeded",
    ]
    return any(marker in text for marker in markers)


def set_symbol_error_cooldown(symbol, seconds=180):
    with symbol_error_lock:
        symbol_error_cooldowns[symbol] = time.time() + max(int(seconds), 30)


def is_symbol_in_error_cooldown(symbol):
    now = time.time()
    with symbol_error_lock:
        expires_at = symbol_error_cooldowns.get(symbol)
        if not expires_at:
            return False
        if expires_at <= now:
            symbol_error_cooldowns.pop(symbol, None)
            return False
        return True


def call_binance(method, *args, **kwargs):
    sync_binance_time()
    fn = getattr(client, method)
    try:
        return fn(*args, **kwargs)
    except Exception as exc:
        if _is_timestamp_error(exc):
            sync_binance_time(force=True)
            return fn(*args, **kwargs)
        if _is_retryable_network_error(exc):
            time.sleep(1.2)
            return fn(*args, **kwargs)
        raise


def build_close_order_params(position, quantity, side):
    params = {
        "symbol": position["symbol"],
        "side": side,
        "type": "MARKET",
        "quantity": quantity,
    }
    position_side = str(position.get("positionSide", "BOTH") or "BOTH").upper()
    if position_side != "BOTH":
        params["positionSide"] = position_side
    else:
        params["reduceOnly"] = True
    return params


def get_current_positions():
    try:
        positions = call_binance("futures_position_information")
        active_symbols = {pos["symbol"] for pos in positions if float(pos.get("positionAmt", 0)) != 0}
        
        account_leverages = {}
        account_isolated = {}
        account_margin_info = {}
        live_tp_map = {}
        live_sl_map = {}
        if active_symbols:
            try:
                account_info = call_binance("futures_account")
                for account_position in account_info.get("positions", []):
                    sym = account_position.get("symbol")
                    if sym in active_symbols:
                        account_leverages[sym] = int(float(account_position.get("leverage", 0) or 0))
                        account_isolated[sym] = bool(account_position.get("isolated", False))
                        account_margin_info[sym] = {
                            "isolated_wallet": float(account_position.get("isolatedWallet", 0) or 0),
                            "position_initial_margin": float(account_position.get("positionInitialMargin", 0) or 0),
                        }
            except Exception as exc:
                print("Error fetching account info for leverages:", exc)
            
            try:
                open_orders = call_binance("futures_get_open_orders")
                for order in open_orders:
                    sym = order.get("symbol")
                    if sym in active_symbols:
                        o_type = order.get("type")
                        stop_price = order.get("stopPrice")
                        if stop_price:
                            try:
                                stop_price = float(stop_price)
                                if stop_price > 0:
                                    if o_type == "TAKE_PROFIT_MARKET":
                                        live_tp_map[sym] = stop_price
                                    elif o_type == "STOP_MARKET":
                                        live_sl_map[sym] = stop_price
                            except (TypeError, ValueError):
                                pass
            except Exception as exc:
                print("Error fetching live open orders for TP/SL:", exc)

        manual_roi_map = load_manual_roi()
        manual_tp_sl_map = load_manual_tp_sl()
        trades = load_trades()
        result = []

        for pos in positions:
            amt = float(pos.get("positionAmt", 0))
            if amt == 0:
                continue

            symbol = pos["symbol"]
            if symbol not in symbol_filters:
                continue
            entry = float(pos.get("entryPrice", 0))
            pnl = float(pos.get("unRealizedProfit", 0))
            
            leverage = account_leverages.get(symbol)
            if leverage is None:
                leverage = get_position_leverage(pos)
                
            margin, calculated_roi = calculate_position_roi_percent(pos, leverage=leverage)
            exchange_margin_info = account_margin_info.get(symbol, {})
            raw_position_margin = float(pos.get("positionInitialMargin", 0) or 0)
            raw_isolated_wallet = float(pos.get("isolatedWallet", 0) or 0)
            exchange_position_margin = float(exchange_margin_info.get("position_initial_margin", 0) or 0)
            exchange_isolated_wallet = float(exchange_margin_info.get("isolated_wallet", 0) or 0)
            display_margin = raw_position_margin or exchange_position_margin or margin
            display_margin_balance = raw_isolated_wallet or exchange_isolated_wallet or (display_margin + pnl)
            margin_source = "exchange" if (raw_position_margin or exchange_position_margin) else "fallback"
            margin_balance_source = "exchange" if (raw_isolated_wallet or exchange_isolated_wallet) else "fallback"
            exchange_based_roi = (pnl / display_margin * 100) if display_margin > 0 else calculated_roi
            manual_roi = manual_roi_map.get(symbol)
            manual_tp_sl = manual_tp_sl_map.get(symbol, {})
            display_roi = float(manual_roi) if manual_roi is not None else exchange_based_roi
            if manual_roi is not None:
                roi_source = "manual"
            elif display_margin > 0 and (raw_position_margin or exchange_position_margin):
                roi_source = "exchange"
            else:
                roi_source = "calculated"
            trade_record = next(
                (
                    trade for trade in reversed(trades)
                    if trade.get("symbol") == symbol and trade.get("status") == "OPEN"
                ),
                None,
            )
            if not trade_record:
                trade_record = ensure_open_trade_record(symbol, position=pos) or {}
            management_state = "Trend active"
            if trade_record.get("trailing_armed"):
                management_state = "Trailing armed"
            elif trade_record.get("breakeven_armed"):
                management_state = "Breakeven armed"
            elif trade_record.get("partial_tp_done"):
                management_state = "Partial TP done"

            try:
                mark_data = client.futures_mark_price(symbol=symbol)
                mark_price = round(float(mark_data.get("markPrice", 0) or 0), 6)
            except Exception:
                mark_price = round(entry, 6)
                
            is_isolated = account_isolated.get(symbol)
            actual_margin_mode = "ISOLATED" if is_isolated else "CROSSED" if is_isolated is not None else ""
            margin_mode = actual_margin_mode or str(trade_record.get("preferred_margin_mode", "") or "").strip() or get_runtime_settings().get("preferred_margin_mode", "ISOLATED")

            tp_val = live_tp_map.get(symbol) or manual_tp_sl.get("tp") or trade_record.get("tp_price")
            sl_val = live_sl_map.get(symbol) or manual_tp_sl.get("sl") or trade_record.get("sl_price")
            try:
                tp_val = float(tp_val or 0)
                sl_val = float(sl_val or 0)
            except (TypeError, ValueError):
                tp_val = 0.0
                sl_val = 0.0

            if (tp_val <= 0 or sl_val <= 0) and entry > 0:
                try:
                    dynamic_tp, dynamic_sl = get_tp_sl_prices(
                        symbol,
                        "BUY" if amt > 0 else "SELL",
                        entry,
                        atr_percent=float(trade_record.get("atr_percent") or 0.28),
                        risk_mode=trade_record.get("risk_mode", "normal"),
                        tp_percent=trade_record.get("tp_percent"),
                        sl_percent=trade_record.get("sl_percent"),
                        leverage=leverage,
                    )
                    if tp_val <= 0:
                        tp_val = dynamic_tp
                    if sl_val <= 0:
                        sl_val = dynamic_sl
                except Exception as exc:
                    print(f"Error calculating dynamic TP/SL for {symbol}:", exc)

            result.append(
                {
                    "symbol": symbol,
                    "markPrice": mark_price,
                    "side": "BUY" if amt > 0 else "SELL",
                    "qty": abs(amt),
                    "entryPrice": round(entry, 4),
                    "leverage": leverage,
                    "margin": round(display_margin, 2),
                    "margin_balance": round(display_margin_balance, 2),
                    "margin_source": margin_source,
                    "margin_balance_source": margin_balance_source,
                    "pnl": round(pnl, 2),
                    "roi": round(display_roi, 2),
                    "roi_source": roi_source,
                    "calculated_roi": round(calculated_roi, 2),
                    "estimated_margin": round(margin, 8),
                    "manual_roi": round(float(manual_roi), 2) if manual_roi is not None else None,
                    "manual_tp": round(float(manual_tp_sl["tp"]), 8) if manual_tp_sl.get("tp") is not None else None,
                    "manual_sl": round(float(manual_tp_sl["sl"]), 8) if manual_tp_sl.get("sl") is not None else None,
                    "peak_roi": round(float(trade_record.get("peak_roi", 0) or 0), 2),
                    "risk_percent": round(float(trade_record.get("risk_percent", 0) or 0), 4),
                    "risk_amount": round(float(trade_record.get("risk_amount", 0) or 0), 4),
                    "risk_reward_ratio": round(float(trade_record.get("risk_reward_ratio", 0) or 0), 4),
                    "position_notional": round(float(trade_record.get("position_notional", 0) or 0), 4),
                    "strategy_family": str(trade_record.get("strategy_family", "") or "").strip(),
                    "preferred_margin_mode": margin_mode,
                    "tp_price": tp_val if tp_val > 0 else None,
                    "sl_price": sl_val if sl_val > 0 else None,
                    "tp_percent": round(float(trade_record.get("tp_percent", 0) or 0), 4),
                    "sl_percent": round(float(trade_record.get("sl_percent", 0) or 0), 4),
                    "partial_tp_done": bool(trade_record.get("partial_tp_done")),
                    "breakeven_armed": bool(trade_record.get("breakeven_armed")),
                    "trailing_armed": bool(trade_record.get("trailing_armed")),
                    "management_state": management_state,
                    "strategy_reason": str(trade_record.get("strategy_reason", "")).strip(),
                    "time": datetime.now().strftime("%H:%M:%S"),
                }
            )

        return result
    except Exception as exc:
        print("Position error:", exc)
        return []


def get_klines(symbol, interval="1m", limit=100):
    try:
        klines = call_binance("futures_klines", symbol=symbol, interval=interval, limit=limit)
        return [float(item[4]) for item in klines]
    except Exception as exc:
        if _is_retryable_network_error(exc):
            set_symbol_error_cooldown(symbol, seconds=240 if config.TESTNET else 120)
        raise


def get_trend_label(closes):
    ema_fast = calculate_ema(closes, 9)
    ema_mid = calculate_ema(closes, 21)
    ema_slow = calculate_ema(closes, 50)

    if ema_fast >= ema_mid >= ema_slow:
        return "bullish"
    if ema_fast <= ema_mid <= ema_slow:
        return "bearish"
    return "mixed"


def get_ema_slope_percent(closes, period=21, lookback=5):
    if len(closes) < max(period, lookback + 2):
        return 0.0

    current_ema = calculate_ema(closes, period)
    previous_ema = calculate_ema(closes[:-lookback], period)
    if previous_ema == 0:
        return 0.0

    return ((current_ema - previous_ema) / previous_ema) * 100


def get_latest_funding_rate(symbol):
    try:
        funding_rows = client.futures_funding_rate(symbol=symbol, limit=1)
        if not funding_rows:
            return None
        return float(funding_rows[-1].get("fundingRate", 0) or 0)
    except Exception as exc:
        print(f"Funding rate error {symbol}: {exc}")
        return None


def supports_pullback(closes, side):
    if len(closes) < 21:
        return False

    profile = get_strategy_profile()
    price = closes[-1]
    previous_price = closes[-2]
    recent_window = closes[-6:]
    ema_mid = calculate_ema(closes, 21)
    ema_fast = calculate_ema(closes, 9)
    if ema_mid <= 0:
        return False

    distance_percent = abs((price - ema_mid) / ema_mid) * 100
    if distance_percent > float(profile["pullback_distance_percent"]):
        return False

    if side == "BUY":
        pullback_depth = min(recent_window) <= ema_fast
        reclaim = price >= ema_mid and price > previous_price and price >= ema_fast
        return pullback_depth and reclaim

    pullback_depth = max(recent_window) >= ema_fast
    reclaim = price <= ema_mid and price < previous_price and price <= ema_fast
    return pullback_depth and reclaim


def confirms_entry_trigger(closes, side):
    if len(closes) < 6:
        return False

    profile = get_strategy_profile()
    price = closes[-1]
    previous_price = closes[-2]
    breakout_high = max(closes[-4:-1])
    breakout_low = min(closes[-4:-1])
    breakout_buffer = float(profile["entry_breakout_buffer_percent"]) / 100

    if side == "BUY":
        return price > previous_price and price >= (breakout_high * (1 + breakout_buffer))
    return price < previous_price and price <= (breakout_low * (1 - breakout_buffer))


def evaluate_strategy_setup(symbol):
    settings = get_runtime_settings()
    disable_trend_filter = settings.get('disable_trend_filter', DISABLE_TREND_FILTER)
    disable_pullback_filter = settings.get('disable_pullback_filter', DISABLE_PULLBACK_FILTER)

    profile = get_strategy_profile()
    closes_1m = get_klines(symbol, interval="1m", limit=120)
    closes_5m = get_klines(symbol, interval="5m", limit=120)
    closes_15m = get_klines(symbol, interval="15m", limit=120)
    closes_1h = get_klines(symbol, interval="1h", limit=120)

    atr_percent = calculate_atr_percent(closes_1m, 14)
    rsi = round(calculate_rsi(closes_1m), 2)
    trend_5m = get_trend_label(closes_5m)
    trend_15m = get_trend_label(closes_15m)
    trend_1h = get_trend_label(closes_1h)
    slope_5m = get_ema_slope_percent(closes_5m, 21, 5)
    slope_15m = get_ema_slope_percent(closes_15m, 21, 5)
    slope_1h = get_ema_slope_percent(closes_1h, 21, 5)

    if not disable_trend_filter and trend_1h == "mixed":
        return {
            "allowed": False,
            "reason": f"Trend 1h ({trend_1h}) masih mixed.",
        }

    fallback_score, fallback_side = evaluate_signal_strength(closes_1m, rsi)
    side = fallback_side if disable_trend_filter else ("BUY" if trend_1h == "bullish" else "SELL")
    if not disable_trend_filter and trend_15m != "mixed":
        side = "BUY" if trend_15m == "bullish" else "SELL"

    atr_limit = MAX_ALLOWED_ATR_PERCENT * (1.5 if RELAXED_SETUP_MODE else 1.0)
    if not TEST_MINIMUM_TRADING_MODE and atr_percent > atr_limit:
        return {
            "allowed": False,
            "reason": f"ATR {atr_percent:.2f}% melebihi batas {atr_limit:.2f}%.",
        }

    if not disable_trend_filter and not RELAXED_SETUP_MODE and trend_5m == "mixed":
        return {
            "allowed": False,
            "reason": "Trend 5m masih mixed, trigger terlalu lemah untuk entry cepat.",
        }

    if not disable_trend_filter and trend_5m != "mixed" and trend_5m != ("bullish" if side == "BUY" else "bearish"):
        return {
            "allowed": False,
            "reason": f"Trend 5m ({trend_5m}) berlawanan dengan bias entry {side}.",
        }

    slope_5m_min = float(profile["min_ema_slope_5m"]) * (0.4 if RELAXED_SETUP_MODE else 1.0)
    slope_15m_min = float(profile["min_ema_slope_15m"]) * (0.5 if RELAXED_SETUP_MODE else 1.0)
    slope_1h_min = float(profile["min_ema_slope_1h"]) * (0.6 if RELAXED_SETUP_MODE else 1.0)
    if not disable_trend_filter and side == "BUY" and (
        slope_15m < slope_15m_min
        or slope_1h < slope_1h_min
        or (not RELAXED_SETUP_MODE and slope_5m < slope_5m_min)
    ):
        return {
            "allowed": False,
            "reason": "Kemiringan EMA belum mendukung BUY di semua timeframe utama.",
        }
    if not disable_trend_filter and side == "SELL" and (
        slope_15m > -slope_15m_min
        or slope_1h > -slope_1h_min
        or (not RELAXED_SETUP_MODE and slope_5m > -slope_5m_min)
    ):
        return {
            "allowed": False,
            "reason": "Kemiringan EMA belum mendukung SELL di semua timeframe utama.",
        }

    pullback_ok = supports_pullback(closes_1m, side)
    trigger_ok = confirms_entry_trigger(closes_1m, side)

    if not disable_pullback_filter and not pullback_ok and not (RELAXED_SETUP_MODE and trigger_ok):
        return {
            "allowed": False,
            "reason": f"Pullback {side} belum valid di timeframe 1m.",
        }

    if not disable_pullback_filter and not trigger_ok and not (RELAXED_SETUP_MODE and pullback_ok):
        return {
            "allowed": False,
            "reason": f"Trigger candle {side} belum menembus struktur micro 1m.",
        }

    funding_rate = get_latest_funding_rate(symbol)
    if not TEST_MINIMUM_TRADING_MODE and funding_rate is not None:
        if side == "BUY" and funding_rate > MAX_ALLOWED_FUNDING_RATE:
            return {
                "allowed": False,
                "reason": f"Funding rate {funding_rate:.5f} terlalu tinggi untuk BUY.",
            }
        if side == "SELL" and funding_rate < -MAX_ALLOWED_FUNDING_RATE:
            return {
                "allowed": False,
                "reason": f"Funding rate {funding_rate:.5f} terlalu rendah untuk SELL.",
            }

    score = fallback_score if disable_trend_filter else 0
    score += 2 if trend_1h == ("bullish" if side == "BUY" else "bearish") else 0
    score += 2 if trend_15m == ("bullish" if side == "BUY" else "bearish") else 0
    score += 1 if trend_5m == ("bullish" if side == "BUY" else "bearish") else 0
    score += 2 if pullback_ok else 0
    score += 2 if trigger_ok else 0
    if side == "BUY" and float(profile["buy_rsi_min"]) <= rsi <= float(profile["buy_rsi_max"]):
        score += 2
    elif side == "SELL" and float(profile["sell_rsi_min"]) <= rsi <= float(profile["sell_rsi_max"]):
        score += 2
    elif side == "BUY" and max(40.0, float(profile["buy_rsi_min"]) - 4.0) <= rsi < float(profile["buy_rsi_min"]):
        score += 1
    elif side == "SELL" and float(profile["sell_rsi_max"]) < rsi <= float(profile["sell_rsi_max"]) + 4.0:
        score += 1
    if funding_rate is None or abs(funding_rate) <= (MAX_ALLOWED_FUNDING_RATE * 0.5):
        score += 1

    return {
        "allowed": True,
        "side": side,
        "score": score,
        "rsi": rsi,
        "atr_percent": atr_percent,
        "funding_rate": funding_rate,
        "closes_1m": closes_1m,
        "trend_5m": trend_5m,
        "trend_15m": trend_15m,
        "trend_1h": trend_1h,
        "reason": (
            f"Bias {side} | trend filter {'off' if disable_trend_filter else 'on'} | "
            f"pullback {'off' if disable_pullback_filter else ('ok' if pullback_ok else 'longgar')} | "
            f"trigger {'ok' if trigger_ok else 'longgar'}, funding aman."
        ),
    }


def get_open_trade_record(symbol, adopt_if_missing=False, position=None):
    trades = load_trades()
    for trade in reversed(trades):
        if trade.get("symbol") == symbol and trade.get("status") == "OPEN":
            return trade
    if adopt_if_missing:
        return ensure_open_trade_record(symbol, position=position)
    return None


def update_open_trade_record(symbol, updates):
    trades = load_trades()
    for trade in reversed(trades):
        if trade.get("symbol") == symbol and trade.get("status") == "OPEN":
            trade.update(updates)
            save_trades(trades)
            return trade
    return None


def close_partial_position(symbol, fraction=PARTIAL_CLOSE_FRACTION, reason="PARTIAL_TP"):
    with trade_execution_lock:
        position = get_open_position(symbol)
        if not position:
            return False, "Posisi tidak ditemukan."

        amt = float(position.get("positionAmt", 0) or 0)
        if amt == 0:
            return False, "Posisi tidak aktif."

        close_side = "SELL" if amt > 0 else "BUY"
        entry = float(position.get("entryPrice", 0) or 0)
        position_side = "BUY" if amt > 0 else "SELL"
        full_qty = abs(amt)
        step = symbol_filters.get(symbol, {}).get("stepSize", 0.001)
        qty = round_step_size(full_qty * fraction, step)

        if qty <= 0 or qty >= full_qty:
            return False, "Qty partial tidak valid."

        try:
            call_binance("futures_create_order", **build_close_order_params(position, qty, close_side))
            trade = get_open_trade_record(symbol) or {}
            if entry > 0:
                set_tp_sl(
                    symbol,
                    position_side,
                    entry,
                    atr_percent=trade.get("atr_percent"),
                    risk_mode=trade.get("risk_mode", "normal"),
                    tp_percent=trade.get("tp_percent"),
                    sl_percent=trade.get("sl_percent"),
                )
            update_open_trade_record(
                symbol,
                {
                    "partial_tp_done": True,
                    "partial_tp_time": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                    "partial_close_qty": qty,
                    "management_reason": reason,
                },
            )
            return True, f"Partial close {symbol} qty {qty} berhasil."
        except Exception as exc:
            print(f"Partial close error {symbol}:", exc)
            return False, str(exc)


def calculate_rsi(closes, period=14):
    gains, losses = [], []
    for index in range(1, len(closes)):
        diff = closes[index] - closes[index - 1]
        gains.append(max(diff, 0))
        losses.append(abs(min(diff, 0)))

    avg_gain = sum(gains[-period:]) / period
    avg_loss = sum(losses[-period:]) / period if sum(losses[-period:]) != 0 else 1
    rs = avg_gain / avg_loss
    return 100 - (100 / (1 + rs))


def score_symbol(symbol):
    try:
        closes = get_klines(symbol)
        rsi = calculate_rsi(closes)
        score, _ = evaluate_signal_strength(closes, rsi)
        return score, round(rsi, 2)
    except Exception:
        return 0, 50


def evaluate_signal_strength(closes, rsi):
    if len(closes) < 21:
        return 0, "BUY"

    avg20 = sum(closes[-20:]) / 20
    price = closes[-1]
    previous_price = closes[-2]
    momentum_5 = price - closes[-6] if len(closes) >= 6 else price - previous_price
    side = "BUY" if price >= avg20 else "SELL"
    if price < avg20 and previous_price > price:
        side = "SELL"
    elif price > avg20 and price > previous_price:
        side = "BUY"

    score = 0
    if side == "BUY":
        score += 2 if price > avg20 else 0
        score += 1 if price > previous_price else 0
        score += 1 if momentum_5 > 0 else 0
        score += 2 if 40 <= rsi <= 65 else 0
        score += 1 if 30 <= rsi < 40 else 0
    else:
        score += 2 if price < avg20 else 0
        score += 1 if price < previous_price else 0
        score += 1 if momentum_5 < 0 else 0
        score += 2 if 35 <= rsi <= 60 else 0
        score += 1 if 60 < rsi <= 70 else 0

    return score, side


def evaluate_ai_trade(symbol, score, rsi, closes, setup=None, balance=0.0, settings=None, performance_context=None):
    settings = settings or get_runtime_settings()
    profile = get_strategy_profile(settings)
    performance_context = performance_context or {}
    extras = {
        "market_regime": profile.get("market_regime", "UNKNOWN"),
        "strategy_mode": profile.get("mode", "BALANCED"),
        "trading_style": normalize_trading_style(settings.get("trading_style", DEFAULT_TRADING_STYLE)),
        "risk_per_trade_percent": float(
            settings.get("risk_per_trade_percent", DEFAULT_RISK_PER_TRADE_PERCENT)
        ),
        "max_risk_per_trade_percent": float(
            settings.get("max_risk_per_trade_percent", MAX_RISK_PER_TRADE_PERCENT)
        ),
        "min_risk_reward_ratio": float(
            settings.get("min_risk_reward_ratio", DEFAULT_MIN_RISK_REWARD_RATIO)
        ),
        "recent_performance_stats": performance_context.get("overall", {}),
        "recent_side_stats": performance_context.get("by_side", {}),
        "recent_strategy_stats": performance_context.get("by_strategy", {}),
        "adaptive_pauses": performance_context.get("adaptive_pauses", {}),
        "recent_pattern_stats": performance_context.get("patterns", {}),
    }
    if setup:
        extras.update(
            {
                "candidate_side": str(setup.get("side", "") or "").upper(),
                "atr_percent": round(float(setup.get("atr_percent", 0) or 0), 4),
                "trend_5m": str(setup.get("trend_5m", "") or "").lower(),
                "trend_15m": str(setup.get("trend_15m", "") or "").lower(),
                "trend_1h": str(setup.get("trend_1h", "") or "").lower(),
                "funding_rate": setup.get("funding_rate"),
            }
        )

    snapshot = build_market_snapshot(symbol, closes, score, rsi, extras=extras)
    decision = decide_trade(snapshot)
    decision["confidence"] = round(max(0.05, min(float(decision.get("confidence", 0) or 0), 0.95)), 4)
    decision["symbol"] = symbol
    if balance > 0:
        suggested_risk_percent = float(
            decision.get("suggested_risk_percent", settings.get("risk_per_trade_percent", DEFAULT_RISK_PER_TRADE_PERCENT))
            or 0
        )
        sl_percent = float(decision.get("sl_percent", 0) or 0)
        decision["suggested_risk_amount"] = round(calculate_risk_amount(balance, suggested_risk_percent), 4)
        decision["suggested_position_notional"] = round(
            calculate_position_size(balance, suggested_risk_percent, sl_percent),
            4,
        )
    decision["checked_at"] = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    return decision


