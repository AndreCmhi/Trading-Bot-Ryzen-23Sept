@app.route("/api/settings", methods=["POST"])
@login_required
@csrf_protect
def update_settings_api():
    payload = request.get_json(silent=True) or {}
    current_settings = get_runtime_settings()
    ai_enabled = bool(payload.get("ai_enabled", current_settings.get("ai_enabled", True)))

    try:
        strategy_mode = normalize_strategy_mode(payload.get("strategy_mode", current_settings.get("strategy_mode", "BALANCED")))
        trading_style = normalize_trading_style(
            payload.get("trading_style", current_settings.get("trading_style", DEFAULT_TRADING_STYLE))
        )
        risk_per_trade_percent = float(
            payload.get(
                "risk_per_trade_percent",
                current_settings.get("risk_per_trade_percent", DEFAULT_RISK_PER_TRADE_PERCENT),
            )
        )
        max_risk_per_trade_percent = float(
            payload.get(
                "max_risk_per_trade_percent",
                current_settings.get("max_risk_per_trade_percent", MAX_RISK_PER_TRADE_PERCENT),
            )
        )
        fixed_trade_notional_usdt = float(
            payload.get(
                "fixed_trade_notional_usdt",
                current_settings.get("fixed_trade_notional_usdt", DEFAULT_FIXED_TRADE_NOTIONAL_USDT),
            )
        )
        min_trade_notional_usdt = float(payload.get("min_trade_notional_usdt", current_settings.get("min_trade_notional_usdt", 5.0)))
        min_risk_reward_ratio = float(
            payload.get(
                "min_risk_reward_ratio",
                current_settings.get("min_risk_reward_ratio", DEFAULT_MIN_RISK_REWARD_RATIO),
            )
        )
        preferred_margin_mode = normalize_margin_mode(
            payload.get(
                "preferred_margin_mode",
                current_settings.get("preferred_margin_mode", DEFAULT_MARGIN_MODE),
            )
        )
        auto_close_enabled = bool(payload.get("auto_close_enabled", current_settings.get("auto_close_enabled", True)))
        auto_close_roi_percent = float(
            payload.get("auto_close_roi_percent", current_settings.get("auto_close_roi_percent", AUTO_CLOSE_ROI_PERCENT))
        )
        hard_stop_roi_percent = float(
            payload.get("hard_stop_roi_percent", current_settings.get("hard_stop_roi_percent", HARD_STOP_ROI_PERCENT))
        )
        auto_blacklist_enabled = bool(
            payload.get("auto_blacklist_enabled", current_settings.get("auto_blacklist_enabled", AUTO_BLACKLIST_ENABLED))
        )
        auto_blacklist_min_trades = int(
            payload.get("auto_blacklist_min_trades", current_settings.get("auto_blacklist_min_trades", AUTO_BLACKLIST_MIN_TRADES))
        )
        auto_blacklist_min_loss_rate = float(
            payload.get("auto_blacklist_min_loss_rate", current_settings.get("auto_blacklist_min_loss_rate", AUTO_BLACKLIST_MIN_LOSS_RATE))
        )
        auto_blacklist_max_total_pnl = float(
            payload.get("auto_blacklist_max_total_pnl", current_settings.get("auto_blacklist_max_total_pnl", AUTO_BLACKLIST_MAX_TOTAL_PNL))
        )
        auto_blacklist_min_hard_stop_rate = float(
            payload.get(
                "auto_blacklist_min_hard_stop_rate",
                current_settings.get("auto_blacklist_min_hard_stop_rate", AUTO_BLACKLIST_MIN_HARD_STOP_RATE),
            )
        )
        auto_blacklist_min_consecutive_losses = int(
            payload.get(
                "auto_blacklist_min_consecutive_losses",
                current_settings.get(
                    "auto_blacklist_min_consecutive_losses",
                    AUTO_BLACKLIST_MIN_CONSECUTIVE_LOSSES,
                ),
            )
        )
        default_leverage = int(payload.get("default_leverage", current_settings.get("default_leverage", DEFAULT_LEVERAGE)))
        min_score = int(payload.get("min_score", current_settings.get("min_score", getattr(config, "MIN_SCORE", 3) or 3)))
        max_open_positions = int(
            payload.get("max_open_positions", current_settings.get("max_open_positions", MAX_OPEN_POSITIONS))
        )
        max_daily_loss_usdt = float(
            payload.get("max_daily_loss_usdt", current_settings.get("max_daily_loss_usdt", MAX_DAILY_LOSS_USDT))
        )
        max_consecutive_losses = int(
            payload.get("max_consecutive_losses", current_settings.get("max_consecutive_losses", MAX_CONSECUTIVE_LOSSES))
        )
        max_trades_per_hour = int(
            payload.get("max_trades_per_hour", current_settings.get("max_trades_per_hour", MAX_TRADES_PER_HOUR))
        )
        max_losses_per_hour = int(
            payload.get("max_losses_per_hour", current_settings.get("max_losses_per_hour", MAX_LOSSES_PER_HOUR))
        )
        hourly_loss_limit_usdt = float(
            payload.get("hourly_loss_limit_usdt", current_settings.get("hourly_loss_limit_usdt", HOURLY_LOSS_LIMIT_USDT))
        )
        loss_cooldown_minutes = int(
            payload.get("loss_cooldown_minutes", current_settings.get("loss_cooldown_minutes", LOSS_COOLDOWN_MINUTES))
        )
        auto_pause_on_guard_halt = bool(
            payload.get(
                "auto_pause_on_guard_halt",
                current_settings.get("auto_pause_on_guard_halt", AUTO_PAUSE_ON_GUARD_HALT),
            )
        )
        auto_close_positions_on_guard_halt = bool(
            payload.get(
                "auto_close_positions_on_guard_halt",
                current_settings.get("auto_close_positions_on_guard_halt", AUTO_CLOSE_POSITIONS_ON_GUARD_HALT),
            )
        )
        max_symbol_trades_per_day = int(
            payload.get("max_symbol_trades_per_day", current_settings.get("max_symbol_trades_per_day", MAX_SYMBOL_TRADES_PER_DAY))
        )
        max_symbol_losses_per_day = int(
            payload.get("max_symbol_losses_per_day", current_settings.get("max_symbol_losses_per_day", MAX_SYMBOL_LOSSES_PER_DAY))
        )
        max_symbol_consecutive_losses = int(
            payload.get(
                "max_symbol_consecutive_losses",
                current_settings.get("max_symbol_consecutive_losses", MAX_SYMBOL_CONSECUTIVE_LOSSES),
            )
        )
        symbol_loss_cooldown_minutes = int(
            payload.get(
                "symbol_loss_cooldown_minutes",
                current_settings.get("symbol_loss_cooldown_minutes", SYMBOL_LOSS_COOLDOWN_MINUTES),
            )
        )
        hard_stop_symbol_cooldown_minutes = int(
            payload.get(
                "hard_stop_symbol_cooldown_minutes",
                current_settings.get("hard_stop_symbol_cooldown_minutes", HARD_STOP_SYMBOL_COOLDOWN_MINUTES),
            )
        )
        trailing_enabled = bool(payload.get("trailing_enabled", current_settings.get("trailing_enabled", True)))
        trailing_trigger_roi_percent = float(payload.get("trailing_trigger_roi_percent", current_settings.get("trailing_trigger_roi_percent", TRAILING_TRIGGER_ROI_PERCENT)))
        trailing_callback_roi_percent = float(payload.get("trailing_callback_roi_percent", current_settings.get("trailing_callback_roi_percent", TRAILING_CALLBACK_ROI_PERCENT)))
        fast_trailing_enabled = bool(payload.get("fast_trailing_enabled", current_settings.get("fast_trailing_enabled", False)))
        fast_trailing_trigger_roi_percent = float(payload.get("fast_trailing_trigger_roi_percent", current_settings.get("fast_trailing_trigger_roi_percent", FAST_TRAILING_TRIGGER_ROI_PERCENT)))
        fast_trailing_callback_roi_percent = float(payload.get("fast_trailing_callback_roi_percent", current_settings.get("fast_trailing_callback_roi_percent", FAST_TRAILING_CALLBACK_ROI_PERCENT)))
        disable_trend_filter = bool(payload.get("disable_trend_filter", current_settings.get("disable_trend_filter", DISABLE_TREND_FILTER)))
        disable_pullback_filter = bool(payload.get("disable_pullback_filter", current_settings.get("disable_pullback_filter", DISABLE_PULLBACK_FILTER)))
    except (TypeError, ValueError):
        return jsonify({"status": "error", "message": "Nilai pengaturan tidak valid."}), 400

    if auto_close_roi_percent <= 0:
        return jsonify({"status": "error", "message": "Auto close ROI harus lebih besar dari 0."}), 400
    if hard_stop_roi_percent >= 0:
        return jsonify({"status": "error", "message": "Hard stop ROI harus lebih kecil dari 0 (negatif)."}), 400
    if not 0 < risk_per_trade_percent <= 2:
        return jsonify({"status": "error", "message": "Risk per trade harus di antara 0 dan 2 persen."}), 400
    if not 0 < max_risk_per_trade_percent <= 2:
        return jsonify({"status": "error", "message": "Batas maksimum risk per trade harus di antara 0 dan 2 persen."}), 400
    if risk_per_trade_percent > max_risk_per_trade_percent:
        return jsonify({"status": "error", "message": "Risk per trade tidak boleh melebihi batas maksimum risk."}), 400
    if fixed_trade_notional_usdt <= 0:
        return jsonify({"status": "error", "message": "Fixed trade notional harus lebih besar dari 0."}), 400
    if min_risk_reward_ratio < 1:
        return jsonify({"status": "error", "message": "Minimal risk-reward ratio harus setidaknya 1."}), 400
    if auto_blacklist_min_trades <= 0:
        return jsonify({"status": "error", "message": "Auto blacklist min trades harus lebih besar dari 0."}), 400
    if not 0 <= auto_blacklist_min_loss_rate <= 1:
        return jsonify({"status": "error", "message": "Auto blacklist min loss rate harus di antara 0 dan 1."}), 400
    if not 0 <= auto_blacklist_min_hard_stop_rate <= 1:
        return jsonify({"status": "error", "message": "Auto blacklist min hard stop rate harus di antara 0 dan 1."}), 400
    if auto_blacklist_min_consecutive_losses <= 0:
        return jsonify({"status": "error", "message": "Auto blacklist loss beruntun harus lebih besar dari 0."}), 400
    if default_leverage <= 0:
        return jsonify({"status": "error", "message": "Leverage harus lebih besar dari 0."}), 400
    if min_score <= 0:
        return jsonify({"status": "error", "message": "Min score harus lebih besar dari 0."}), 400
    if max_open_positions <= 0:
        return jsonify({"status": "error", "message": "Batas open position harus lebih besar dari 0."}), 400
    if max_daily_loss_usdt <= 0:
        return jsonify({"status": "error", "message": "Daily loss harus lebih besar dari 0."}), 400
    if max_consecutive_losses <= 0:
        return jsonify({"status": "error", "message": "Loss beruntun harus lebih besar dari 0."}), 400
    if max_trades_per_hour <= 0:
        return jsonify({"status": "error", "message": "Batas trade per jam harus lebih besar dari 0."}), 400
    if max_losses_per_hour <= 0:
        return jsonify({"status": "error", "message": "Batas loss per jam harus lebih besar dari 0."}), 400
    if hourly_loss_limit_usdt <= 0:
        return jsonify({"status": "error", "message": "Batas rugi per jam harus lebih besar dari 0."}), 400
    if loss_cooldown_minutes < 0:
        return jsonify({"status": "error", "message": "Cooldown setelah loss tidak boleh negatif."}), 400
    if max_symbol_trades_per_day <= 0:
        return jsonify({"status": "error", "message": "Batas trade per simbol harus lebih besar dari 0."}), 400
    if max_symbol_losses_per_day <= 0:
        return jsonify({"status": "error", "message": "Batas loss per simbol harus lebih besar dari 0."}), 400
    if max_symbol_consecutive_losses <= 0:
        return jsonify({"status": "error", "message": "Loss beruntun per simbol harus lebih besar dari 0."}), 400
    if symbol_loss_cooldown_minutes < 0:
        return jsonify({"status": "error", "message": "Cooldown loss per simbol tidak boleh negatif."}), 400
    if hard_stop_symbol_cooldown_minutes < 0:
        return jsonify({"status": "error", "message": "Cooldown HARD_STOP per simbol tidak boleh negatif."}), 400

    settings = update_runtime_settings(
        {
            "ai_enabled": ai_enabled,
            "strategy_mode": strategy_mode,
            "trading_style": trading_style,
            "risk_per_trade_percent": round(risk_per_trade_percent, 4),
            "max_risk_per_trade_percent": round(max_risk_per_trade_percent, 4),
            "fixed_trade_notional_usdt": round(fixed_trade_notional_usdt, 4),
            "min_trade_notional_usdt": round(min_trade_notional_usdt, 4),
            "min_transaksi": int(payload.get("min_transaksi", current_settings.get("min_transaksi", 1))),
            "min_risk_reward_ratio": round(min_risk_reward_ratio, 4),
            "preferred_margin_mode": preferred_margin_mode,
            "auto_close_enabled": auto_close_enabled,
            "auto_close_roi_percent": round(auto_close_roi_percent, 2),
            "hard_stop_roi_percent": round(hard_stop_roi_percent, 2),
            "auto_blacklist_enabled": auto_blacklist_enabled,
            "auto_blacklist_min_trades": auto_blacklist_min_trades,
            "auto_blacklist_min_loss_rate": round(auto_blacklist_min_loss_rate, 2),
            "auto_blacklist_max_total_pnl": round(auto_blacklist_max_total_pnl, 2),
            "auto_blacklist_min_hard_stop_rate": round(auto_blacklist_min_hard_stop_rate, 2),
            "auto_blacklist_min_consecutive_losses": auto_blacklist_min_consecutive_losses,
            "default_leverage": default_leverage,
            "min_score": min_score,
            "max_open_positions": max_open_positions,
            "max_daily_loss_usdt": round(max_daily_loss_usdt, 2),
            "max_consecutive_losses": max_consecutive_losses,
            "max_trades_per_hour": max_trades_per_hour,
            "max_losses_per_hour": max_losses_per_hour,
            "hourly_loss_limit_usdt": round(hourly_loss_limit_usdt, 2),
            "loss_cooldown_minutes": loss_cooldown_minutes,
            "auto_pause_on_guard_halt": auto_pause_on_guard_halt,
            "auto_close_positions_on_guard_halt": auto_close_positions_on_guard_halt,
            "max_symbol_trades_per_day": max_symbol_trades_per_day,
            "max_symbol_losses_per_day": max_symbol_losses_per_day,
            "max_symbol_consecutive_losses": max_symbol_consecutive_losses,
            "symbol_loss_cooldown_minutes": symbol_loss_cooldown_minutes,
            "hard_stop_symbol_cooldown_minutes": hard_stop_symbol_cooldown_minutes,
            "trailing_enabled": trailing_enabled,
            "disable_trend_filter": disable_trend_filter,
            "disable_pullback_filter": disable_pullback_filter,
            "trailing_trigger_roi_percent": round(trailing_trigger_roi_percent, 2),
            "trailing_callback_roi_percent": round(trailing_callback_roi_percent, 2),
            "fast_trailing_enabled": fast_trailing_enabled,
            "fast_trailing_trigger_roi_percent": round(fast_trailing_trigger_roi_percent, 2),
            "fast_trailing_callback_roi_percent": round(fast_trailing_callback_roi_percent, 2),
        }
    )
    rebuild_auto_blacklist()

    socketio.emit("ai_status", get_ai_status_payload())
    emit_stats()
    return jsonify(
        {
            "status": "ok",
            "message": "Pengaturan berhasil diperbarui.",
            "settings": settings,
        }
    )


@app.route("/api/close_position", methods=["POST"])
@login_required
@csrf_protect
def close_position_api():
    payload = request.get_json(silent=True) or {}
    symbol = str(payload.get("symbol", "")).upper().strip()

    if not symbol:
        return jsonify({"status": "error", "message": "Symbol wajib diisi."}), 400

    success, message = close_position(symbol, reason="MANUAL_CLOSE")
    status_code = 200 if success else 400
    return jsonify({"status": "ok" if success else "error", "message": message}), status_code


@app.route("/api/close_all_positions", methods=["POST"])
@login_required
@csrf_protect
def close_all_positions_api():
    result = close_all_positions(reason="MANUAL_CLOSE_ALL")
    socketio.emit("update_dashboard", {"open_positions": get_current_positions(), "time": datetime.now().strftime("%H:%M:%S")})
    emit_stats()
    return jsonify(
        {
            "status": "ok",
            "message": f"{result['closed_count']} posisi berhasil ditutup, {result['failed_count']} gagal.",
            **result,
        }
    )


@app.route("/api/manual_roi", methods=["POST"])
@login_required
@csrf_protect
def manual_roi_api():
    payload = request.get_json(silent=True) or {}
    symbol = str(payload.get("symbol", "")).upper().strip()

    if not symbol:
        return jsonify({"status": "error", "message": "Symbol wajib diisi."}), 400

    manual_roi_map = load_manual_roi()
    roi_value = payload.get("roi")

    if roi_value in ("", None):
        manual_roi_map.pop(symbol, None)
        save_manual_roi(manual_roi_map)
        return jsonify({"status": "ok", "message": f"ROI manual {symbol} dihapus."})

    try:
        manual_roi_map[symbol] = round(float(roi_value), 2)
    except (TypeError, ValueError):
        return jsonify({"status": "error", "message": "ROI manual harus berupa angka."}), 400

    save_manual_roi(manual_roi_map)
    return jsonify(
        {
            "status": "ok",
            "message": f"ROI manual {symbol} disimpan.",
            "symbol": symbol,
            "roi": manual_roi_map[symbol],
        }
    )


@app.route("/api/manual_tp_sl", methods=["POST"])
@login_required
@csrf_protect
def manual_tp_sl_api():
    payload = request.get_json(silent=True) or {}
    symbol = str(payload.get("symbol", "")).upper().strip()

    if not symbol:
        return jsonify({"status": "error", "message": "Symbol wajib diisi."}), 400

    tp_value = payload.get("tp")
    sl_value = payload.get("sl")

    if tp_value in ("", None) or sl_value in ("", None):
        return jsonify({"status": "error", "message": "TP dan SL wajib diisi."}), 400

    try:
        tp = float(tp_value)
        sl = float(sl_value)
    except (TypeError, ValueError):
        return jsonify({"status": "error", "message": "TP dan SL harus berupa angka."}), 400

    position = get_open_position(symbol)
    if not position:
        return jsonify({"status": "error", "message": "Posisi aktif tidak ditemukan untuk symbol ini."}), 400

    amt = float(position.get("positionAmt", 0))
    entry = float(position.get("entryPrice", 0))
    side = "BUY" if amt > 0 else "SELL"
    validation_error = validate_tp_sl(side, entry, tp, sl)
    if validation_error:
        return jsonify({"status": "error", "message": validation_error}), 400

    manual_tp_sl_map = load_manual_tp_sl()
    manual_tp_sl_map[symbol] = {
        "tp": tp,
        "sl": sl,
        "updated_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
    }
    save_manual_tp_sl(manual_tp_sl_map)

    try:
        set_tp_sl(symbol, side, entry)
    except Exception as exc:
        return jsonify({"status": "error", "message": str(exc)}), 400

    saved_tp, saved_sl = get_tp_sl_prices(symbol, side, entry)
    return jsonify(
        {
            "status": "ok",
            "message": f"TP/SL manual {symbol} berhasil disimpan.",
            "symbol": symbol,
            "tp": saved_tp,
            "sl": saved_sl,
        }
    )


@socketio.on("connect")
def handle_connect():
    if not is_authenticated():
        return False

    stats = calculate_stats()
    history_monitor = refresh_trade_history_monitor()
    dashboard_payload = {
        "open_positions": get_current_positions(),
        "stats": stats,
        "time": datetime.now().strftime("%H:%M:%S"),
    }

    socketio.emit(
        "bot_status",
        get_bot_status_payload(),
        to=request.sid,
    )
    socketio.emit("update_dashboard", dashboard_payload, to=request.sid)
    socketio.emit("update_stats", stats, to=request.sid)
    socketio.emit("ai_status", get_ai_status_payload(), to=request.sid)
    socketio.emit("history_monitor", history_monitor, to=request.sid)


def start_background_tasks():
    threading.Thread(target=auto_scan, daemon=True).start()
    threading.Thread(target=auto_close, daemon=True).start()
    threading.Thread(target=realtime, daemon=True).start()


def market_regime_daemon():
    while True:
        try:
            refresh_market_regime(force=True)
        except Exception as exc:
            print(f"MARKET REGIME REFRESH ERROR: {exc}")
        time.sleep(MARKET_REGIME_REFRESH_SECONDS)


def history_monitor_daemon():
    while True:
        try:
            refresh_trade_history_monitor(force=True, emit=True)
        except Exception as exc:
            print(f"HISTORY MONITOR ERROR: {exc}")
        time.sleep(HISTORY_MONITOR_REFRESH_SECONDS)


def bootstrap_market_state():
    while True:
        try:
            load_exchange_filters()
            refresh_market_regime(force=True)
            print(f"MARKET READY: {len(symbol_filters)} symbols loaded")
            return
        except Exception as exc:
            print(f"MARKET BOOTSTRAP ERROR: {exc}")
            time.sleep(15)


def get_lan_ip():
    """Best-effort local IP to help open the app from another device on the same network."""
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        sock.connect(("8.8.8.8", 80))
        return sock.getsockname()[0]
    except OSError:
        return "127.0.0.1"
    finally:
        sock.close()


initialize_runtime_settings()
rebuild_auto_blacklist()
refresh_trade_history_monitor(force=True)
threading.Thread(target=bootstrap_market_state, daemon=True).start()
threading.Thread(target=market_regime_daemon, daemon=True).start()
threading.Thread(target=history_monitor_daemon, daemon=True).start()
start_background_tasks()


if __name__ == "__main__":
    if APP_PASSWORD == "ganti-password-ini":
        raise RuntimeError("APP_PASSWORD masih default. Ganti dulu sebelum menjalankan bot.")
    if APP_SECRET_KEY == "ganti-secret-key-ini":
        raise RuntimeError("APP_SECRET_KEY masih default. Ganti dulu sebelum menjalankan bot.")
    lan_ip = get_lan_ip()
    print("BOT READY")
    print(f"Local   : http://127.0.0.1:{DEFAULT_PORT}")
    print(f"Network : http://{lan_ip}:{DEFAULT_PORT}")
    print(f"Login   : username={APP_USERNAME}")
    print(f"Symbols : {len(get_scan_symbols())} futures USDT perpetual aktif")
    socketio.run(
        app,
        host=DEFAULT_HOST,
        port=DEFAULT_PORT,
        debug=False,
        allow_unsafe_werkzeug=True,
    )















